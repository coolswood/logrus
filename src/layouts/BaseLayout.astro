---
import '@fontsource-variable/montserrat';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: 'ru' | 'en' | 'fi';
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = 'LOGRUS RY — Международное общество поддержки молодёжных инициатив',
  description = 'LOGRUS ry: театр, молодежные творческие студии, танцевальные мастер-классы, фестивали и практика в Хельсинки, Финляндия.',
  lang = 'ru',
  ogImage = '/images/theatre-art.webp',
  noindex = false,
} = Astro.props;

const siteURL = Astro.site || new URL('https://logrus.fi');
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const ogImageURL = new URL(ogImage, siteURL).toString();

// Calculate hreflang paths
let currentSlug = Astro.url.pathname.replace(/^\/(en|fi)(\/|$)/, '/');
if (!currentSlug.startsWith('/')) currentSlug = '/' + currentSlug;
if (currentSlug.length > 1 && currentSlug.endsWith('/')) currentSlug = currentSlug.slice(0, -1);
if (currentSlug === '//') currentSlug = '/';

const isTheatre = currentSlug === '/theatre';
const ruURL = new URL(currentSlug === '/' ? '' : currentSlug.slice(1), siteURL).toString();
const enURL = new URL(isTheatre ? 'en' : (currentSlug === '/' ? 'en' : 'en' + currentSlug), siteURL).toString();
const fiURL = new URL(isTheatre ? 'fi' : (currentSlug === '/' ? 'fi' : 'fi' + currentSlug), siteURL).toString();

const ogLocale = lang === 'ru' ? 'ru_RU' : lang === 'fi' ? 'fi_FI' : 'en_US';
---

<!doctype html>
<html lang={lang} class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Multilingual Hreflang Tags -->
    {!noindex && (
      <>
        <link rel="alternate" hreflang="ru" href={ruURL} />
        <link rel="alternate" hreflang="en" href={enURL} />
        <link rel="alternate" hreflang="fi" href={fiURL} />
        <link rel="alternate" hreflang="x-default" href={ruURL} />
      </>
    )}



    <!-- Primary Meta Tags & SEO -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
  </head>
  <body class="flex min-h-screen min-h-[100dvh] flex-col bg-[#fcfbfa] text-zinc-950 antialiased selection:bg-zinc-900 selection:text-white">
    <Header currentLang={lang} />
    <main class="flex-1 flex flex-col">
      <slot />
    </main>
    <Footer currentLang={lang} />
  </body>
</html>
