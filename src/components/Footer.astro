---
const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-[#0d0d0e] text-zinc-300">
  <!-- Top 3-Column Section -->
  <div class="mx-auto max-w-7xl px-4 sm:px-8 pt-14 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-16 items-start">
      <!-- Column 1: Contact -->
      <div class="flex flex-col gap-4">
        <h4 class="font-heading text-sm font-bold tracking-widest text-white uppercase">
          КОНТАКТЫ
        </h4>
        
        <div class="flex flex-col gap-3.5 text-xs text-zinc-300">
          <!-- Address 1 -->
          <div class="flex items-start gap-3">
            <svg class="h-4 w-4 shrink-0 text-zinc-400 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <div class="leading-relaxed">
              <p class="text-white font-medium">Logrus ry / Teatteri Logrus</p>
              <p class="text-zinc-400">Сцена Narri: Sörnäisten rantatie 31, Helsinki</p>
              <p class="text-zinc-400">Студии: Nuorisotalo Kontula, Ostostie 4, Helsinki</p>
            </div>
          </div>

          <!-- Email -->
          <div class="flex items-center gap-3">
            <svg class="h-4 w-4 shrink-0 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            <a href="mailto:info@logrus.fi" class="hover:text-white transition-colors">
              info@logrus.fi
            </a>
          </div>

          <!-- Phone -->
          <div class="flex items-center gap-3">
            <svg class="h-4 w-4 shrink-0 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <div class="flex flex-col gap-0.5">
              <a href="tel:+358458977777" class="hover:text-white transition-colors">
                +358 45 897 7777 (Кристина)
              </a>
              <a href="tel:+358451537303" class="hover:text-white transition-colors text-zinc-400">
                +358 45 153 7303 (Елена)
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Column 2: Follow Us -->
      <div class="flex flex-col items-start md:items-center gap-4">
        <h4 class="font-heading text-sm font-bold tracking-widest text-white uppercase">
          МЫ В СОЦСЕТЯХ
        </h4>
        
        <div class="flex items-center gap-3">
          <!-- Facebook -->
          <a
            href="https://www.facebook.com/logrusry"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-zinc-700 bg-zinc-900/60 text-white transition-all hover:bg-white hover:text-black hover:border-white"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
            </svg>
          </a>

          <!-- Instagram -->
          <a
            href="https://www.instagram.com/logrus.fi"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-zinc-700 bg-zinc-900/60 text-white transition-all hover:bg-white hover:text-black hover:border-white"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          </a>

          <!-- YouTube -->
          <a
            href="https://youtube.com/@logrus"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="YouTube"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-zinc-700 bg-zinc-900/60 text-white transition-all hover:bg-white hover:text-black hover:border-white"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
            </svg>
          </a>

          <!-- VK -->
          <a
            href="https://vk.com/logrusry"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="VK"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-zinc-700 bg-zinc-900/60 text-white transition-all hover:bg-white hover:text-black hover:border-white"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
              <path d="M13.162 18.994c.609 0 .858-.406.858-.783 0-.616-.035-1.928.847-2.222.868-.288 1.986 1.83 3.163 2.646.883.614 1.554.48 1.554.48l3.14-.044s1.644-.102.864-1.396c-.064-.105-.458-.962-2.358-2.731-1.988-1.85-1.722-1.55.674-4.743 1.46-1.944 2.044-3.13 1.86-3.642-.176-.489-1.266-.36-1.266-.36l-3.535.023s-.262-.036-.456.078c-.19.112-.312.373-.312.373s-.56 1.49-1.307 2.76c-1.575 2.684-2.204 2.827-2.461 2.66-.599-.387-.45-1.555-.45-2.385 0-2.593.393-3.674-.766-3.953-.385-.092-.668-.153-1.654-.163-1.264-.013-2.336.007-2.942.304-.403.197-.714.639-.524.664.234.031.764.143 1.045.525.364.494.351 1.606.351 1.606s.209 3.053-.488 3.433c-.479.26-1.136-.271-2.548-2.71-.722-1.248-1.268-2.628-1.268-2.628s-.105-.258-.293-.396c-.228-.168-.548-.221-.548-.221l-3.36.023s-.504.014-.689.233c-.164.195-.013.598-.013.598s2.632 6.16 5.613 9.273c2.733 2.855 5.845 2.668 5.845 2.668z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 3: Newsletter -->
      <div class="flex flex-col gap-4">
        <h4 class="font-heading text-sm font-bold tracking-widest text-white uppercase">
          НОВОСТИ И СОБЫТИЯ
        </h4>
        
        <p class="text-xs text-zinc-400">
          Подпишитесь на анонсы спектаклей и молодежных встреч.
        </p>

        <form class="flex items-center gap-0 w-full" onsubmit="event.preventDefault(); alert('Спасибо за подписку на новости Logrus ry!');">
          <input
            type="email"
            placeholder="Ваш email"
            required
            class="flex-1 rounded-l bg-zinc-900 border border-zinc-800 px-3.5 py-2.5 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-zinc-500 transition-colors"
          />
          <button
            type="submit"
            class="rounded-r bg-white px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-black hover:bg-zinc-200 transition-colors cursor-pointer shrink-0"
          >
            ПОДПИСАТЬСЯ
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Bottom Copyright Bar -->
  <div class="border-t border-zinc-800/80">
    <div class="mx-auto flex max-w-7xl flex-col sm:flex-row items-center justify-between px-4 sm:px-8 py-5 text-[11px] text-zinc-500 gap-2">
      <p>© {currentYear} Logrus ry — Общество поддержки молодёжных инициатив</p>
      <p>Все права защищены.</p>
    </div>
  </div>
</footer>
