---
interface Props {
  currentLang?: 'ru' | 'en' | 'fi';
}

const { currentLang = 'ru' } = Astro.props;
const currentYear = new Date().getFullYear();

const i18n = {
  ru: {
    contactsTitle: 'Контакты',
    address: 'Sibeliuksenkatu 19B, 00250 Helsinki',
    socialsTitle: 'Мы в соцсетях',
    newsTitle: 'Новости и события',
    newsDesc: 'Подпишитесь на анонсы спектаклей и проектов.',
    emailPlaceholder: 'Ваш email',
    subscribeBtn: 'Подписаться',
    copyright: `© 2006–${currentYear} Logrus ry (Y-tunnus 2040144-2). Все права защищены.`,
    rights: 'Зарегистрированная некоммерческая ассоциация в Финляндии.',
  },
  en: {
    contactsTitle: 'Contacts',
    address: 'Sibeliuksenkatu 19B, 00250 Helsinki, Finland',
    socialsTitle: 'Social Media',
    newsTitle: 'News & Updates',
    newsDesc: 'Subscribe to announcements for upcoming performances and youth initiatives.',
    emailPlaceholder: 'Your email address',
    subscribeBtn: 'Subscribe',
    copyright: `© 2006–${currentYear} Logrus ry (Business ID: 2040144-2). All rights reserved.`,
    rights: 'Registered Non-Profit Association in Finland.',
  },
  fi: {
    contactsTitle: 'Yhteystiedot',
    address: 'Sibeliuksenkatu 19B, 00250 Helsinki',
    socialsTitle: 'Sosiaalinen media',
    newsTitle: 'Uutiset ja tapahtumat',
    newsDesc: 'Tilaa uutiskirjeemme saadaksesi tietoa tulevista esityksistä ja hankkeista.',
    emailPlaceholder: 'Sähköpostiosoitteesi',
    subscribeBtn: 'Tilaa',
    copyright: `© 2006–${currentYear} Logrus ry (Y-tunnus 2040144-2). Kaikki oikeudet pidätetään.`,
    rights: 'Rekisteröity kulttuuriyhdistys Suomessa.',
  },
}[currentLang];
---

<footer class="w-full bg-[#16181b] text-white mt-auto py-12 sm:py-16">
  <div class="site-container">
    <!-- Top 3-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10 lg:gap-12 pb-10 sm:pb-12 border-b border-zinc-800">
      
      <!-- Column 1: Contacts -->
      <div class="flex flex-col gap-3.5">
        <h3 class="text-xs font-extrabold tracking-widest uppercase text-white">
          {i18n.contactsTitle}
        </h3>
        <div class="flex flex-col gap-3 text-xs text-zinc-300">
          <!-- Address -->
          <div class="flex items-start gap-3">
            <svg class="h-4 w-4 shrink-0 text-zinc-400 mt-0.5 fill-none stroke-current stroke-2" width="16" height="16" aria-hidden="true" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="leading-snug">{i18n.address}</span>
          </div>

          <!-- Email -->
          <div class="flex items-center gap-3">
            <svg class="h-4 w-4 shrink-0 text-zinc-400 fill-none stroke-current stroke-2" width="16" height="16" aria-hidden="true" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:info@logrus.fi" class="hover:text-white transition-colors">
              info@logrus.fi
            </a>
          </div>
        </div>
      </div>

      <!-- Column 2: Social Media -->
      <div class="flex flex-col gap-3.5">
        <h3 class="text-xs font-extrabold tracking-widest uppercase text-white">
          {i18n.socialsTitle}
        </h3>
        <div class="flex items-center gap-3 pt-0.5">
          <!-- Instagram -->
          <a
            href="https://www.instagram.com/teat.rus"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-zinc-700 bg-zinc-900 text-white transition-all hover:bg-white hover:text-black hover:border-white hover:scale-105"
          >
            <svg class="h-4 w-4 fill-current" width="16" height="16" aria-hidden="true" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 3: Newsletter Form -->
      <div class="flex flex-col gap-3">
        <div class="flex flex-col gap-1.5">
          <h3 class="text-xs font-extrabold tracking-widest uppercase text-white">
            {i18n.newsTitle}
          </h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            {i18n.newsDesc}
          </p>
        </div>
        <form
          class="flex w-full mt-1"
          action="https://api.web3forms.com/submit"
          method="POST"
        >
          <input type="hidden" name="access_key" value="d339e2be-fcc3-44e3-bce8-cfa7d2a89bfd" />
          <input type="hidden" name="subject" value="Новый подписчик на сайте Logrus ry" />
          <input
            type="email"
            id="newsletter-email"
            name="email"
            aria-label={i18n.emailPlaceholder}
            placeholder={i18n.emailPlaceholder}
            required
            class="flex-1 min-w-0 bg-[#212529] border border-zinc-700 px-3.5 py-2.5 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-zinc-400 rounded-l-sm"
          />
          <button
            type="submit"
            class="bg-white px-4 py-2.5 text-[11px] font-black uppercase tracking-wider text-black hover:bg-zinc-200 transition-colors cursor-pointer shrink-0 rounded-r-sm"
          >
            {i18n.subscribeBtn}
          </button>
        </form>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between pt-7 sm:pt-8 text-[11px] text-zinc-400 gap-3 text-center sm:text-left">
      <div>{i18n.copyright}</div>
      <div>{i18n.rights}</div>
    </div>
  </div>
</footer>
