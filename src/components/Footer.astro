---
interface Props {
  currentLang?: 'ru' | 'en' | 'fi';
}

const { currentLang = 'ru' } = Astro.props;
const currentYear = new Date().getFullYear();

const i18n = {
  ru: {
    contactsTitle: 'КОНТАКТЫ',
    address: 'Sörnäisten rantatie 31 / Sibeliuksenkatu 19B, Хельсинки',
    socialsTitle: 'МЫ В СОЦСЕТЯХ',
    newsTitle: 'НОВОСТИ И СОБЫТИЯ',
    newsDesc: 'Подпишитесь на анонсы спектаклей и молодежных встреч.',
    emailPlaceholder: 'Ваш email',
    subscribeBtn: 'ПОДПИСАТЬСЯ',
    copyright: `© ${currentYear} Logrus ry — Общество поддержки молодёжных инициатив`,
    rights: 'Все права защищены.',
  },
  en: {
    contactsTitle: 'CONTACT US',
    address: 'Sörnäisten rantatie 31 / Sibeliuksenkatu 19B, Helsinki',
    socialsTitle: 'FOLLOW US',
    newsTitle: 'NEWS & EVENTS',
    newsDesc: 'Subscribe for updates on upcoming performances and youth programs.',
    emailPlaceholder: 'Your email address',
    subscribeBtn: 'SUBSCRIBE',
    copyright: `© ${currentYear} Logrus ry — International Youth Support Society`,
    rights: 'All rights reserved.',
  },
  fi: {
    contactsTitle: 'YHTEYSTIEDOT',
    address: 'Sörnäisten rantatie 31 / Sibeliuksenkatu 19B, Helsinki',
    socialsTitle: 'SOSIAALINEN MEDIA',
    newsTitle: 'UUTISET JA TAPAHTUMAT',
    newsDesc: 'Tilaa uutiskirjeemme saadaksesi tietoa tulevista esityksistä ja työpajoista.',
    emailPlaceholder: 'Sähköpostiosoitteesi',
    subscribeBtn: 'TILAA',
    copyright: `© ${currentYear} Logrus ry — Kansainvälinen nuorisoseura`,
    rights: 'Kaikki oikeudet pidätetään.',
  },
}[currentLang];
---

<footer class="w-full bg-[#16181b] text-white">
  <div class="site-container py-14">
    <!-- Top 3-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-14 pb-12 border-b border-zinc-800">
      
      <!-- Column 1: Contacts -->
      <div class="flex flex-col gap-4">
        <h4 class="text-xs font-extrabold tracking-widest uppercase text-white">
          {i18n.contactsTitle}
        </h4>
        <div class="flex flex-col gap-3 text-xs text-zinc-300">
          <!-- Address -->
          <div class="flex items-start gap-3">
            <svg class="h-4 w-4 shrink-0 text-zinc-400 mt-0.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{i18n.address}</span>
          </div>

          <!-- Email -->
          <div class="flex items-center gap-3">
            <svg class="h-4 w-4 shrink-0 text-zinc-400 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:info@logrus.fi" class="hover:text-white transition-colors">
              info@logrus.fi
            </a>
          </div>

          <!-- Phone -->
          <div class="flex items-center gap-3">
            <svg class="h-4 w-4 shrink-0 text-zinc-400 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <div class="flex flex-col gap-0.5">
              <a href="tel:+358458977777" class="hover:text-white transition-colors">
                +358 45 897 7777
              </a>
              <a href="tel:+358451537303" class="hover:text-white transition-colors text-zinc-400">
                +358 45 153 7303
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Column 2: Social Media -->
      <div class="flex flex-col gap-4">
        <h4 class="text-xs font-extrabold tracking-widest uppercase text-white">
          {i18n.socialsTitle}
        </h4>
        <div class="flex items-center gap-3">
          <!-- Facebook -->
          <a
            href="https://www.facebook.com/logrusry"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-zinc-700 bg-zinc-900 text-white transition-all hover:bg-white hover:text-black hover:border-white hover:scale-105"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
            </svg>
          </a>

          <!-- Instagram -->
          <a
            href="https://www.instagram.com/teat.rus"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-zinc-700 bg-zinc-900 text-white transition-all hover:bg-white hover:text-black hover:border-white hover:scale-105"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          </a>

          <!-- YouTube -->
          <a
            href="https://www.youtube.com/@logrusry2011"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="YouTube"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-zinc-700 bg-zinc-900 text-white transition-all hover:bg-white hover:text-black hover:border-white hover:scale-105"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
            </svg>
          </a>

          <!-- VK -->
          <a
            href="https://vk.com/logrusry"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="VK"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-zinc-700 bg-zinc-900 text-white transition-all hover:bg-white hover:text-black hover:border-white hover:scale-105"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
              <path d="M13.162 18.994c.609 0 .858-.406.858-.783 0-.616-.035-1.928.847-2.222.868-.288 1.986 1.83 3.163 2.646.883.614 1.554.48 1.554.48l3.14-.044s1.644-.102.864-1.396c-.064-.105-.458-.962-2.358-2.731-1.988-1.85-1.722-1.55.674-4.743 1.46-1.944 2.044-3.13 1.86-3.642-.176-.489-1.266-.36-1.266-.36l-3.535.023s-.262-.036-.456.078c-.19.112-.312.373-.312.373s-.56 1.49-1.307 2.76c-1.575 2.684-2.204 2.827-2.461 2.66-.599-.387-.45-1.555-.45-2.385 0-2.593.393-3.674-.766-3.953-.385-.092-.668-.153-1.654-.163-1.264-.013-2.336.007-2.942.304-.403.197-.714.639-.524.664.234.031.764.143 1.045.525.364.494.351 1.606.351 1.606s.209 3.053-.488 3.433c-.479.26-1.136-.271-2.548-2.71-.722-1.248-1.268-2.628-1.268-2.628s-.105-.258-.293-.396c-.228-.168-.548-.221-.548-.221l-3.36.023s-.504.014-.689.233c-.164.195-.013.598-.013.598s2.632 6.16 5.613 9.273c2.733 2.855 5.845 2.668 5.845 2.668z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 3: Newsletter Form -->
      <div class="flex flex-col gap-4">
        <h4 class="text-xs font-extrabold tracking-widest uppercase text-white">
          {i18n.newsTitle}
        </h4>
        <p class="text-xs text-zinc-400">
          {i18n.newsDesc}
        </p>
        <form
          class="flex w-full"
          action="https://api.web3forms.com/submit"
          method="POST"
        >
          <input type="hidden" name="access_key" value="d339e2be-fcc3-44e3-bce8-cfa7d2a89bfd" />
          <input type="hidden" name="subject" value="Новый подписчик на сайте Logrus!" />
          <input
            type="email"
            name="email"
            placeholder={i18n.emailPlaceholder}
            required
            class="flex-1 bg-[#212529] border border-zinc-700 px-3.5 py-2.5 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-zinc-400"
          />
          <button
            type="submit"
            class="bg-white px-4 py-2.5 text-[11px] font-black uppercase tracking-wider text-black hover:bg-zinc-200 transition-colors cursor-pointer shrink-0"
          >
            {i18n.subscribeBtn}
          </button>
        </form>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between pt-6 text-[11px] text-zinc-500 gap-2">
      <div>{i18n.copyright}</div>
      <div>{i18n.rights}</div>
    </div>
  </div>
</footer>
