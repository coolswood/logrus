---
interface Props {
  title: string;
  description: string;
  image: string;
  href?: string;
  icon: 'theatre' | 'initiatives' | 'archive' | 'about' | 'involved';
}

const { title, description, image, href = '#', icon } = Astro.props;
---

<a
  href={href}
  class="group relative block w-[280px] sm:w-[310px] lg:w-[325px] h-[325px] sm:h-[360px] lg:h-[378px] transition-transform duration-300 hover:-translate-y-2 focus:outline-none"
>
  <!-- Outer Hexagon Wrapper with drop-shadow and 1.5px border -->
  <div class="hex-shadow hex-clip relative h-full w-full bg-zinc-300/80 p-[1.5px]">
    <!-- Inner Hexagon Content -->
    <div class="hex-clip relative flex h-full w-full flex-col bg-white overflow-hidden">
      <!-- Photo (Top ~46%) -->
      <div class="relative h-[46%] w-full overflow-hidden bg-zinc-900">
        <img
          src={image}
          alt={title}
          class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent"></div>
      </div>

      <!-- White Info Card (Bottom ~54%) with upward chevron peak -->
      <div
        class="relative -mt-6 flex flex-1 flex-col items-center justify-between bg-white pt-7 pb-6 px-6 text-center transition-colors group-hover:bg-zinc-50/50"
        style="clip-path: polygon(0% 24px, 50% 0%, 100% 24px, 100% 100%, 0% 100%); -webkit-clip-path: polygon(0% 24px, 50% 0%, 100% 24px, 100% 100%, 0% 100%);"
      >
        <!-- Icon -->
        <div class="flex h-10 w-10 items-center justify-center text-zinc-900 transition-transform duration-300 group-hover:scale-110">
          {icon === 'theatre' && (
            <svg class="h-8 w-8 stroke-current fill-none stroke-[1.4]" viewBox="0 0 48 48">
              {/* Comedy & Tragedy masks */}
              <path d="M18 10C11 10 7 16 7 24C7 32 11 38 18 38C22 38 25 35 27 31C25 31 23 29 23 26C23 18 20 10 18 10Z" />
              <ellipse cx="14" cy="20" rx="1.8" ry="1.2" fill="currentColor" />
              <ellipse cx="20" cy="20" rx="1.8" ry="1.2" fill="currentColor" />
              <path d="M13 28C15 32 19 32 21 28" stroke-linecap="round" />
              
              <path d="M30 14C37 14 41 20 41 28C41 36 37 42 30 42C26 42 23 39 21 35C23 35 25 33 25 30C25 22 28 14 30 14Z" />
              <ellipse cx="28" cy="24" rx="1.8" ry="1.2" fill="currentColor" />
              <ellipse cx="34" cy="24" rx="1.8" ry="1.2" fill="currentColor" />
              <path d="M28 34C30 31 34 31 36 34" stroke-linecap="round" />
            </svg>
          )}

          {icon === 'initiatives' && (
            <svg class="h-8 w-8 stroke-current fill-none stroke-[1.4]" viewBox="0 0 48 48">
              {/* Community people figures */}
              <circle cx="24" cy="16" r="4.5" />
              <path d="M16 34C16 29 19.5 26 24 26C28.5 26 32 29 32 34" stroke-linecap="round" />
              
              <circle cx="12" cy="20" r="3.5" />
              <path d="M6 34C6 30.5 8.5 28 12 28C13.5 28 15 28.5 16 29.5" stroke-linecap="round" />

              <circle cx="36" cy="20" r="3.5" />
              <path d="M42 34C42 30.5 39.5 28 36 28C34.5 28 33 28.5 32 29.5" stroke-linecap="round" />
            </svg>
          )}

          {icon === 'archive' && (
            <svg class="h-8 w-8 stroke-current fill-none stroke-[1.4]" viewBox="0 0 48 48">
              {/* Archive storage box */}
              <rect x="8" y="14" width="32" height="7" rx="1.5" />
              <path d="M11 21V36C11 37.5 12.5 39 14 39H34C35.5 39 37 37.5 37 36V21" />
              <rect x="20" y="27" width="8" height="4" rx="1.5" />
            </svg>
          )}

          {icon === 'about' && (
            <svg class="h-8 w-8 stroke-current fill-none stroke-[1.4]" viewBox="0 0 48 48">
              {/* Profile icon */}
              <circle cx="24" cy="17" r="6" />
              <path d="M11 37C11 30 16.5 27 24 27C31.5 27 37 30 37 37" stroke-linecap="round" />
            </svg>
          )}

          {icon === 'involved' && (
            <svg class="h-8 w-8 stroke-current fill-none stroke-[1.4]" viewBox="0 0 48 48">
              {/* Handshake */}
              <path d="M8 25L17 17C18.5 15.5 21 15.5 22.5 17L28 22" stroke-linecap="round" />
              <path d="M8 32L15 25" stroke-linecap="round" />
              
              <path d="M40 25L31 17C29.5 15.5 27 15.5 25.5 17L21 21" stroke-linecap="round" />
              <path d="M40 32L33 25" stroke-linecap="round" />

              <path d="M21 21L24 24C25 25 26.5 25 27.5 24L30 21" stroke-linecap="round" />
              <path d="M19 23L22 26C23 27 24.5 27 25.5 26L28 23" stroke-linecap="round" />
              <path d="M17 25L20 28C21 29 22.5 29 23.5 28L26 25" stroke-linecap="round" />
            </svg>
          )}
        </div>

        <!-- Title & Description -->
        <div class="flex flex-col items-center">
          <h3 class="font-heading text-base sm:text-lg font-bold tracking-wider text-zinc-950 uppercase group-hover:text-black">
            {title}
          </h3>
          <p class="mt-1 text-xs text-zinc-600 max-w-[210px] leading-relaxed">
            {description}
          </p>
        </div>

        <!-- Action Arrow -->
        <div class="mt-2 flex items-center justify-center text-zinc-800 transition-transform duration-300 group-hover:translate-x-1">
          <svg class="h-4 w-4 stroke-current stroke-2 fill-none" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </div>
      </div>
    </div>
  </div>
</a>
