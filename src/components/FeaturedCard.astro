---
interface Props {
  title: string;
  description: string;
  image: string;
  href: string;
  icon: 'theatre' | 'projects' | 'archive' | 'about';
  variant?: 'dark' | 'light';
  external?: boolean;
  priority?: boolean;
}

const {
  title,
  description,
  image,
  href,
  icon,
  variant = 'light',
  external = false,
  priority = false,
} = Astro.props;

const isDark = variant === 'dark';
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class={`group relative h-[420px] sm:h-[460px] lg:h-[480px] overflow-hidden flex flex-col justify-end p-8 sm:p-9 transition-transform duration-300 hover:-translate-y-1 bg-zinc-900 rounded ${
    isDark ? 'text-white' : 'text-zinc-950'
  }`}
>
  <!-- Background Image with Lazy/Eager Loading & Explicit Dimensions to avoid CLS -->
  <img
    src={image}
    alt={title}
    width="640"
    height="480"
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : 'auto'}
    class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 z-[1]"
  />

  {isDark ? (
    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-black/20 z-[2]" />
  ) : (
    <div class="card-slanted-panel transition-colors group-hover:bg-[#f0e8df]" />
  )}

  <!-- Content Block -->
  <div class="relative z-[3] flex flex-col">
    <!-- Icon -->
    <div class={`mb-3.5 ${isDark ? 'text-white' : 'text-zinc-950'}`}>
      {icon === 'theatre' && (
        <svg class="h-8 w-8 fill-current" viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-3 7c.83 0 1.5.67 1.5 1.5S9.83 12 9 12s-1.5-.67-1.5-1.5S8.17 9 9 9zm6 0c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5-1.5-.67-1.5-1.5.67-1.5 1.5-1.5zm-3 9c-2.33 0-4.31-1.46-5.11-3.5h10.22c-.8 2.04-2.78 3.5-5.11 3.5z"/>
        </svg>
      )}

      {icon === 'projects' && (
        <svg class="h-8 w-8 fill-current" viewBox="0 0 24 24">
          <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
        </svg>
      )}

      {icon === 'archive' && (
        <svg class="h-8 w-8 fill-current" viewBox="0 0 24 24">
          <path d="M20.54 5.23l-1.39-1.68C18.88 3.21 18.47 3 18 3H6c-.47 0-.88.21-1.16.55L3.46 5.23C3.17 5.57 3 6.02 3 6.5V19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6.5c0-.48-.17-.93-.46-1.27zM12 17.5L6.5 12H10v-2h4v2h3.5L12 17.5zM5.12 5l.81-1h12l.94 1H5.12z"/>
        </svg>
      )}

      {icon === 'about' && (
        <svg class="h-8 w-8 fill-current" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      )}
    </div>

    <!-- Title -->
    <h2 class="text-2xl sm:text-3xl font-black tracking-wider uppercase mb-1.5 leading-tight">
      {title}
    </h2>

    <!-- Description -->
    <p class={`text-sm sm:text-[15px] font-medium leading-snug max-w-[92%] mb-3.5 ${
      isDark ? 'text-zinc-200' : 'text-zinc-700'
    }`}>
      {description}
    </p>

    <!-- Arrow -->
    <span class="text-xl font-bold inline-block transition-transform duration-200 group-hover:translate-x-1.5 leading-none">
      &rarr;
    </span>
  </div>
</a>
