---
interface Props {
  currentLang?: 'ru' | 'en' | 'fi';
}

const { currentLang = 'ru' } = Astro.props;

const currentPath = Astro.url.pathname;
let pathWithoutLang = currentPath.replace(/^\/(en|fi)(\/|$)/, '/');
if (!pathWithoutLang.startsWith('/')) pathWithoutLang = '/' + pathWithoutLang;
if (pathWithoutLang === '//') pathWithoutLang = '/';

const isTheatre = pathWithoutLang === '/theatre';
const ruHref = pathWithoutLang;
const enHref = isTheatre ? '/en' : (pathWithoutLang === '/' ? '/en' : `/en${pathWithoutLang}`);
const fiHref = isTheatre ? '/fi' : (pathWithoutLang === '/' ? '/fi' : `/fi${pathWithoutLang}`);

const homeHref = currentLang === 'ru' ? '/' : `/${currentLang}`;
---

<header class="w-full bg-white border-b border-zinc-200 sticky top-0 z-40">
  <div class="site-container py-5 flex flex-col sm:flex-row items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a href={homeHref} class="flex items-center gap-3.5 group">
      <picture>
        <source srcset="/images/logo-logrus.webp" type="image/webp" />
        <img
          src="/images/logo-logrus.png"
          alt={currentLang === 'ru' ? 'Логрус' : 'Logrus'}
          width="97"
          height="48"
          class="h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
        />
      </picture>
    </a>

    <!-- Header Right Controls -->
    <div class="flex items-center gap-4 sm:gap-5">
      <!-- Social Media Icons (SVGs - No FontAwesome dependency!) -->
      <div class="flex items-center gap-3">
        <!-- Facebook -->
        <a
          href="https://www.facebook.com/logrusry"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="flex h-9 w-9 items-center justify-center rounded-full bg-zinc-950 text-white transition-all hover:bg-zinc-700 hover:scale-105"
        >
          <svg class="h-3.5 w-3.5 fill-current" width="14" height="14" aria-hidden="true" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
          </svg>
        </a>

        <!-- Instagram -->
        <a
          href="https://www.instagram.com/teat.rus"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="flex h-9 w-9 items-center justify-center rounded-full bg-zinc-950 text-white transition-all hover:bg-zinc-700 hover:scale-105"
        >
          <svg class="h-3.5 w-3.5 fill-current" width="14" height="14" aria-hidden="true" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
          </svg>
        </a>

        <!-- YouTube -->
        <a
          href="https://www.youtube.com/@logrusry2011"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="YouTube"
          class="flex h-9 w-9 items-center justify-center rounded-full bg-zinc-950 text-white transition-all hover:bg-zinc-700 hover:scale-105"
        >
          <svg class="h-3.5 w-3.5 fill-current" width="14" height="14" aria-hidden="true" viewBox="0 0 24 24">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
          </svg>
        </a>
      </div>

      <!-- Vertical Divider -->
      <div class="h-6 w-px bg-zinc-300"></div>

      <!-- Language Switcher -->
      <nav aria-label="Language" class="flex items-center gap-1.5 text-xs font-bold tracking-wider">
        <a
          href={enHref}
          aria-current={currentLang === 'en' ? 'page' : undefined}
          class={`transition-colors ${currentLang === 'en' ? 'text-zinc-950 underline underline-offset-4' : 'text-zinc-600 hover:text-zinc-900'}`}
        >
          EN
        </a>
        <span class="text-zinc-300" aria-hidden="true">|</span>
        <a
          href={fiHref}
          aria-current={currentLang === 'fi' ? 'page' : undefined}
          class={`transition-colors ${currentLang === 'fi' ? 'text-zinc-950 underline underline-offset-4' : 'text-zinc-600 hover:text-zinc-900'}`}
        >
          FI
        </a>
        <span class="text-zinc-300" aria-hidden="true">|</span>
        <a
          href={ruHref}
          aria-current={currentLang === 'ru' ? 'page' : undefined}
          class={`transition-colors ${currentLang === 'ru' ? 'text-zinc-950 underline underline-offset-4' : 'text-zinc-600 hover:text-zinc-900'}`}
        >
          RU
        </a>
      </nav>
    </div>
  </div>
</header>
