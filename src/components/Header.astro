---
---

<header class="w-full bg-white/95 backdrop-blur-sm border-b border-zinc-100 z-40 sticky top-0">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-8">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3.5 group">
      <!-- Hexagonal Logo Mark with Theatre Mask -->
      <div class="relative flex h-11 w-11 items-center justify-center">
        <svg
          viewBox="0 0 100 115"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="h-11 w-11 drop-shadow-sm transition-transform duration-300 group-hover:scale-105"
        >
          <!-- Hexagon background -->
          <polygon
            points="50 3, 97 30, 97 85, 50 112, 3 85, 3 30"
            fill="#09090b"
            stroke="#09090b"
            stroke-width="4"
            stroke-linejoin="round"
          />
          <!-- Theatrical Mask in white -->
          <path
            d="M50 24C35 24 26 36 26 54C26 73 36 86 50 86C64 86 74 73 74 54C74 36 65 24 50 24Z"
            fill="none"
            stroke="#ffffff"
            stroke-width="3.5"
            stroke-linejoin="round"
          />
          <!-- Mask slanted eyes -->
          <path
            d="M36 46C38 42 42 41 45 44"
            stroke="#ffffff"
            stroke-width="3"
            stroke-linecap="round"
          />
          <path
            d="M64 46C62 42 58 41 55 44"
            stroke="#ffffff"
            stroke-width="3"
            stroke-linecap="round"
          />
          <!-- Eye cutouts -->
          <ellipse cx="40" cy="51" rx="4.5" ry="3" fill="#ffffff" />
          <ellipse cx="60" cy="51" rx="4.5" ry="3" fill="#ffffff" />
          <!-- Dramatic smiling mouth -->
          <path
            d="M38 66C44 74 56 74 62 66"
            stroke="#ffffff"
            stroke-width="3"
            stroke-linecap="round"
          />
          <!-- Nose line -->
          <path
            d="M50 51V60"
            stroke="#ffffff"
            stroke-width="2.5"
            stroke-linecap="round"
          />
        </svg>
      </div>

      <!-- Brand Text -->
      <div class="flex flex-col">
        <span class="font-heading text-lg font-bold tracking-wider leading-none text-zinc-950">
          NORDIC STAGE
        </span>
        <span class="text-[10px] font-medium tracking-[0.18em] text-zinc-600 mt-1 uppercase">
          THEATRE ASSOCIATION
        </span>
      </div>
    </a>

    <!-- Right Controls -->
    <div class="flex items-center gap-3 sm:gap-5">
      <!-- Social Media Icons (Circles) -->
      <div class="hidden md:flex items-center gap-2">
        <!-- Facebook -->
        <a
          href="https://facebook.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="flex h-8 w-8 items-center justify-center rounded-full bg-zinc-900 text-white transition-all hover:bg-zinc-700 hover:scale-105"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
          </svg>
        </a>

        <!-- Instagram -->
        <a
          href="https://instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="flex h-8 w-8 items-center justify-center rounded-full bg-zinc-900 text-white transition-all hover:bg-zinc-700 hover:scale-105"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
          </svg>
        </a>

        <!-- YouTube -->
        <a
          href="https://youtube.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="YouTube"
          class="flex h-8 w-8 items-center justify-center rounded-full bg-zinc-900 text-white transition-all hover:bg-zinc-700 hover:scale-105"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
          </svg>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://linkedin.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="flex h-8 w-8 items-center justify-center rounded-full bg-zinc-900 text-white transition-all hover:bg-zinc-700 hover:scale-105"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
          </svg>
        </a>
      </div>

      <!-- Divider -->
      <div class="hidden sm:block h-6 w-[1px] bg-zinc-300"></div>

      <!-- Donate Button with Heart -->
      <a
        href="#donate"
        class="inline-flex items-center gap-2 rounded-md bg-zinc-950 px-4 sm:px-5 py-2 text-xs font-semibold uppercase tracking-wider text-white shadow-sm hover:bg-zinc-800 transition-all hover:shadow"
      >
        <svg
          class="h-3.5 w-3.5 fill-none stroke-current stroke-2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"
          />
        </svg>
        <span>DONATE</span>
      </a>

      <!-- Divider -->
      <div class="hidden sm:block h-6 w-[1px] bg-zinc-300"></div>

      <!-- Language Switcher -->
      <div class="flex items-center gap-1.5 text-xs tracking-wider">
        <span class="font-bold text-zinc-950 cursor-pointer hover:text-black">EN</span>
        <span class="text-zinc-400">|</span>
        <span class="font-medium text-zinc-500 cursor-pointer hover:text-zinc-950">FI</span>
        <span class="text-zinc-400">|</span>
        <span class="font-medium text-zinc-500 cursor-pointer hover:text-zinc-950">RU</span>
      </div>
    </div>
  </div>
</header>
