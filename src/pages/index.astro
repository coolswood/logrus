---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeaturedCard from '@/components/FeaturedCard.astro';
---

<BaseLayout
  title="LOGRUS RY — Международное общество поддержки молодёжных инициатив"
  description="Официальный сайт общества LOGRUS RY в Финляндии: театр, творческие курсы, фестивали и практика для молодежи."
  lang="ru"
>
  <!-- Hero Section -->
  <section class="text-center pt-10 pb-12 sm:pt-14 sm:pb-16">
    <div class="site-container">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight uppercase mb-2 leading-none">
        LOGRUS RY
      </h1>
      <div class="text-lg sm:text-2xl font-extrabold tracking-[0.15em] uppercase text-zinc-800 mb-5">
        THEATRE & CULTURE ASSOCIATION
      </div>
      <div class="w-28 h-0.5 bg-zinc-950 mx-auto mb-5"></div>
      <p class="text-xs sm:text-sm font-semibold tracking-widest uppercase text-zinc-600 max-w-xl mx-auto">
        Международное общество поддержки молодёжных инициатив
      </p>
    </div>
  </section>

  <!-- 2x2 Cards Grid -->
  <section class="pb-20">
    <div class="site-container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-7 sm:gap-8">
        <!-- THEATRE -->
        <FeaturedCard
          title="ТЕАТР"
          description="Официальный сайт Театра «Logrus»: репертуар, спектакли, актеры и премьеры"
          image="/images/card-theatre.webp"
          href="https://www.teatterilogrus.fi/"
          external={true}
          icon="theatre"
          variant="dark"
          priority={true}
        />

        <!-- PROJECTS -->
        <FeaturedCard
          title="ПРОЕКТЫ"
          description="Мастер-классы, молодежные инициативы, аренда реквизита и многое другое"
          image="/images/card-initiatives.webp"
          href="/projects"
          icon="projects"
          variant="light"
          priority={true}
        />

        <!-- ARCHIVE -->
        <FeaturedCard
          title="АРХИВ"
          description="История постановок, архив выступлений, фестивали и фотоотчеты"
          image="/images/card-archive.webp"
          href="/archive"
          icon="archive"
          variant="light"
        />

        <!-- ABOUT -->
        <FeaturedCard
          title="О НАС"
          description="Наша миссия, ценности, контакты команды и практика через TE-toimisto"
          image="/images/card-about.webp"
          href="/about"
          icon="about"
          variant="light"
        />
      </div>
    </div>
  </section>
</BaseLayout>