---
import BaseLayout from "@/layouts/BaseLayout.astro";

const archiveItemsFestivals = [
  {
    tag: 'Фестиваль / Лагерь',
    title: '«Общественная среда» и интеграция',
    date: '2022 — 2024',
    image: '/images/archive-community.webp',
    description: 'Серия культурных встреч, языковых мастер-классов и молодежных интеграционных лагерей в Финляндии.',
    meta: [
      { label: 'Партнеры', val: 'Caisa, Kanneltalo, TE-toimisto' },
    ],
  },
  {
    tag: 'Архив студий',
    title: 'Студии дефиле и китайского танца',
    date: 'Сезон 2025 — 2026 (Завершён)',
    image: '/images/archive-studios.webp',
    description: 'Бесплатные творческие занятия для подростков и молодежи 14–25 лет. Отработка сценических номеров, дефиле в традиционных костюмах и подготовка к праздничному гала-концерту «Январские встречи».',
    meta: [
      { label: 'Локация', val: 'Nuorisotalo Kontula, Ostostie 4, Helsinki' },
      { label: 'Статус', val: 'Проект успешно реализован' },
    ],
  },
];

const archiveItemsPast = [
  {
    tag: 'Спектакль',
    title: '«NOVECENTO»',
    date: 'Ноябрь 2025',
    image: '/images/theatre-clean.webp',
    description: 'Спектакль по пьесе Алессандро Барикко в сотрудничестве с клубом DanceSport Studio. История легендарного пианиста с океанского лайнера.',
    meta: [
      { label: 'Режиссёр', val: 'Аквиле Рузгите' },
      { label: 'Сцена', val: 'Narri, Sörnäisten rantatie 31, Хельсинки' },
    ],
  },
  {
    tag: 'Спектакль',
    title: '«SILVIA»',
    date: '2026',
    image: '/images/archive-silvia.webp',
    description: 'Комедийная и трогательная постановка по пьесе Альберта Рамсделла Герни-младшего о дружбе, семье и преданности.',
    meta: [
      { label: 'Театр', val: 'Logrus Teatteri' },
      { label: 'Сцена', val: 'Narrin näyttämö' },
    ],
  },
  {
    tag: 'Семейный спектакль',
    title: '«Тайна пропавшего кольца»',
    date: 'Сезон 2024',
    image: '/images/archive-ring.webp',
    description: 'Семейный интерактивный спектакль молодежного театра центра Helmi по мотивам классических английских сказок.',
    meta: [
      { label: 'Организатор', val: 'Logrus Ry / Helmi-keskus' },
    ],
  },
  {
    tag: 'Драма',
    title: '«Молодая хозяйка Нискавуори»',
    date: '2021 — 2022',
    image: '/images/niskavuori.webp',
    description: 'Классическая финская драма Хеллы Вуолийоки о борьбе традиций, любви и долга в родовом поместье Нискавуори.',
    meta: [
      { label: 'Театр', val: 'Logrus Teatteri' },
    ],
  },
  {
    tag: 'Показ мод',
    title: 'Показ мод «The Hipsters»',
    date: '2019',
    image: '/images/fashion-hipsters.webp',
    description: 'Молодежный показ мод винтажных и стилизованных костюмов, созданных в костюмерной мастерской Logrus ry.',
    meta: [
      { label: 'Организатор', val: 'Logrus ry' },
    ],
  },
  {
    tag: 'Фестиваль',
    title: 'Международный фестиваль «Art-Planet»',
    date: '2016 — 2018',
    image: '/images/art-planet-2020.webp',
    description: 'Ежегодный многожанровый фестиваль детского и молодежного творчества, объединивший коллективы из стран Балтийского региона.',
    meta: [
      { label: 'Площадка', val: 'Helsinki' },
    ],
  },
  {
    tag: 'Конкурс',
    title: 'Фестиваль-конкурс «Gloria Star»',
    date: '2013 — 2015',
    image: '/images/spektr-2016.webp',
    description: 'Вокально-хореографический конкурс для талантливой молодежи с участием международных судей и мастер-классами.',
    meta: [
      { label: 'Организатор', val: 'Logrus ry' },
    ],
  },
];
---

<BaseLayout
  title="Архив событий и постановок — LOGRUS RY"
  description="Архив театральных постановок, фестивалей Gloria Star, Art-Planet и молодежных проектов общества LOGRUS ry с 2012 года."
  lang="ru"
  ogImage="/images/niskavuori.webp"
>
  <!-- Page Hero -->
  <section class="bg-white border-b border-zinc-200 py-12 sm:py-16 text-center">
    <div class="site-container">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight uppercase mb-3">
        Архив событий
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 max-w-xl mx-auto font-medium">
        Хроника спектаклей, фестивалей, показов мод и молодежных проектов с 2012 года.
      </p>
    </div>
  </section>

  <!-- Archive Timeline Section -->
  <section class="py-14 sm:py-16">
    <div class="site-container">
      
      <!-- Section: Festivals & Studios -->
      <div class="mb-16">
        <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-zinc-950 mb-8 border-b-2 border-zinc-950 pb-2 inline-block">
          Фестивали и студии
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
          {archiveItemsFestivals.map((item, index) => (
            <div class="bg-white border border-zinc-200 rounded-lg overflow-hidden flex flex-col shadow-sm transition-transform duration-200 hover:-translate-y-1">
              <div class="h-56 relative bg-zinc-900 overflow-hidden">
                <span class="absolute top-3 left-3 bg-zinc-950/80 backdrop-blur-xs text-white text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded z-10">
                  {item.tag}
                </span>
                <img
                  src={item.image}
                  alt={item.title}
                  width="480"
                  height="320"
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                  fetchpriority={index === 0 ? "high" : undefined}
                  class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                />
              </div>
              <div class="p-6 flex flex-col flex-1 justify-between">
                <div>
                  <div class="text-xs font-bold text-zinc-600 mb-1.5">{item.date}</div>
                  <h3 class="text-lg font-black uppercase text-zinc-950 mb-2.5 leading-snug">{item.title}</h3>
                  <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed mb-4">{item.description}</p>
                </div>
                <div class="pt-3 border-t border-zinc-100 text-xs text-zinc-600 space-y-1">
                  {item.meta.map((m) => (
                    <div><strong>{m.label}:</strong> {m.val}</div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Section: Past Seasons -->
      <div>
        <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-zinc-950 mb-8 border-b-2 border-zinc-950 pb-2 inline-block">
          Ранее в репертуаре
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
          {archiveItemsPast.map((item) => (
            <div class="bg-white border border-zinc-200 rounded-lg overflow-hidden flex flex-col shadow-sm transition-transform duration-200 hover:-translate-y-1">
              <div class="h-56 relative bg-zinc-900 overflow-hidden">
                <span class="absolute top-3 left-3 bg-zinc-950/80 backdrop-blur-xs text-white text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded z-10">
                  {item.tag}
                </span>
                <img
                  src={item.image}
                  alt={item.title}
                  width="480"
                  height="320"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                />
              </div>
              <div class="p-6 flex flex-col flex-1 justify-between">
                <div>
                  <div class="text-xs font-bold text-zinc-600 mb-1.5">{item.date}</div>
                  <h3 class="text-lg font-black uppercase text-zinc-950 mb-2.5 leading-snug">{item.title}</h3>
                  <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed mb-4">{item.description}</p>
                </div>
                <div class="pt-3 border-t border-zinc-100 text-xs text-zinc-600 space-y-1">
                  {item.meta.map((m) => (
                    <div><strong>{m.label}:</strong> {m.val}</div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</BaseLayout>