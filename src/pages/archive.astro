---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Хроника и архив мероприятий — LOGRUS RY"
  description="Архив театральных постановок, фестивалей, показов мод, мастер-классов и молодежных проектов Logrus ry с 2010 года."
  lang="ru"
  ogImage="/images/niskavuori.webp"
>
  <!-- Page Hero -->
  <section class="bg-white border-b border-zinc-200 py-12 sm:py-16 text-center">
    <div class="site-container">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight uppercase mb-3 text-zinc-950">
        Архив событий
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 max-w-2xl mx-auto font-medium leading-relaxed">
        Хроника спектаклей, фестивалей, показов мод, мастер-классов и молодежных проектов с 2010 года.
      </p>
    </div>
  </section>

  <!-- Controls: Search & Category Filter -->
  <section class="py-8 bg-[#fcfbfa] border-b border-zinc-200/80 sticky top-[73px] z-30 backdrop-blur-md bg-[#fcfbfa]/95">
    <div class="site-container flex flex-col md:flex-row items-center justify-between gap-4">
      
      <!-- Search Input -->
      <div class="w-full md:w-80 relative">
        <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-zinc-400 pointer-events-none fill-none stroke-current stroke-2" width="16" height="16" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <input
          type="text"
          id="archiveSearch"
          placeholder="Поиск по названию или описанию..."
          aria-label="Поиск по названию или описанию..."
          class="w-full pl-10 pr-4 py-2.5 bg-white border border-zinc-200 rounded-lg text-xs font-semibold text-zinc-950 placeholder-zinc-400 focus:outline-none focus:border-zinc-950 focus:ring-1 focus:ring-zinc-950 transition-all shadow-xs"
        />
      </div>

      <!-- Category Filter Buttons -->
      <div class="flex flex-wrap items-center gap-2" id="categoryFilters">
        <button class="filter-btn active bg-zinc-950 text-white text-xs font-black uppercase tracking-wider px-4 py-2 rounded-full transition-all cursor-pointer shadow-xs" data-filter="all">Все записи</button>
        <button class="filter-btn bg-zinc-100 text-zinc-700 hover:bg-zinc-200 hover:text-zinc-950 text-xs font-black uppercase tracking-wider px-4 py-2 rounded-full transition-all cursor-pointer" data-filter="Театр">Театр</button>
        <button class="filter-btn bg-zinc-100 text-zinc-700 hover:bg-zinc-200 hover:text-zinc-950 text-xs font-black uppercase tracking-wider px-4 py-2 rounded-full transition-all cursor-pointer" data-filter="Мода">Мода</button>
        <button class="filter-btn bg-zinc-100 text-zinc-700 hover:bg-zinc-200 hover:text-zinc-950 text-xs font-black uppercase tracking-wider px-4 py-2 rounded-full transition-all cursor-pointer" data-filter="Фестивали">Фестивали</button>
        <button class="filter-btn bg-zinc-100 text-zinc-700 hover:bg-zinc-200 hover:text-zinc-950 text-xs font-black uppercase tracking-wider px-4 py-2 rounded-full transition-all cursor-pointer" data-filter="События">События</button>
        <button class="filter-btn bg-zinc-100 text-zinc-700 hover:bg-zinc-200 hover:text-zinc-950 text-xs font-black uppercase tracking-wider px-4 py-2 rounded-full transition-all cursor-pointer" data-filter="Образование">Образование</button>
        <button class="filter-btn bg-zinc-100 text-zinc-700 hover:bg-zinc-200 hover:text-zinc-950 text-xs font-black uppercase tracking-wider px-4 py-2 rounded-full transition-all cursor-pointer" data-filter="Студии">Студии</button>

      </div>

    </div>
  </section>

  <!-- Archive Content Stream -->
  <section class="py-12 sm:py-16 flex-1">
    <div class="site-container" id="archiveList">
      
      <!-- Year 2025 -->
      <section class="year-group mb-14 sm:mb-16" data-year="2025">
        <div class="flex items-center gap-4 mb-6 sm:mb-8">
          <span class="bg-zinc-950 text-white text-xs sm:text-sm font-black tracking-widest uppercase px-4 py-1.5 rounded-full">
            2025
          </span>
          <div class="flex-1 h-px bg-zinc-200"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
          
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Театр">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Театр
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  03.02.2025
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                🎭 Открытая театральная группа в театре «Логрус»
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Творческая команда театра «Логрус» открывает двери в увлекательный мир театрального искусства! Это уникальная возможность погрузиться в магию сцены, раскрыть свой творческий потенциал и овладеть искусством актёрской игры.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Набор в группу</span></div>
          </article>
        </div>
      </section>
      <!-- Year 2024 -->
      <section class="year-group mb-14 sm:mb-16" data-year="2024">
        <div class="flex items-center gap-4 mb-6 sm:mb-8">
          <span class="bg-zinc-950 text-white text-xs sm:text-sm font-black tracking-widest uppercase px-4 py-1.5 rounded-full">
            2024
          </span>
          <div class="flex-1 h-px bg-zinc-200"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
          
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="События">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  События
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  07.12.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Видеоотчет «Рождественские встречи» в Хельсинки
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Совместное мероприятие Logrus ry и Encanta Oy. Состоялся удивительный концерт и праздник: Сергей Флоров («шаман с бубном») открыл вечер, наполнив пространство теплой атмосферой и предновогодним волшебством.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Праздник</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Театр">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Театр
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  15.09.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Семейный спектакль «Тайна пропавшего перстня»
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Молодёжный театр центра «Жемчужина» и Logrus Ry представили увлекательный семейный спектакль по мотивам классических английских сказок. Благодарим участников и зрителей за поддержку и сказочную атмосферу!
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Премьера</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Фестивали">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Фестивали
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  03.08.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Средневековая ярмарка в городе Коувола
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Logrus Ry принял участие в традиционной средневековой ярмарке в Коуволе. Были представлены исторические женские платья и мужские рубашки из натурального льна и хлопка ручной работы.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Ярмарка</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="События">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  События
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  10.05.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Прогулка по Хельсинки с Александром Васильевым
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Небольшая весенняя прогулка и неформальная встреча в Хельсинки со всемирно известным историком моды и искусствоведом Александром Васильевым при участии команды Logrus ry и Encanta Oy.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Встреча</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Театр">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Театр
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  07.04.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Спектакль «Красивая жизнь» на гастролях в Ювяскюля
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Гастрольный выезд театра «Логрус» в Ювяскюля с революционной трагикомедией Жана Ануя «Красивая жизнь» (режиссер Аквиле Рузгите). Выражаем искреннюю благодарность зрителям и партнерам за теплый прием!
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Гастроли</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Мода">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Мода
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  09.02.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Аренда образов и нарядов на бал «Vanhat Tanssit»
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Традиционный бал гимназистов Vanhat tanssit в Хельсинки! Logrus ry и Encanta Oy предлагают коллекцию бальных платьев, фраков и аксессуаров по доступным ценам с индивидуальной подгонкой образа.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Костюмы</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Студии">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Студии
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  03.02.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Открытый мастер-класс по фламенко
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Бесплатный открытый урок «Фламенко для начинающих» от преподавателя Раисат Гессель в молодежном центре Luuppi (Kontula, Helsinki). Знакомство с базовыми ритмами, осанкой и пластикой танца.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Мастер-класс</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Образование">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Образование
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  20.01.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Курс авторских лекций Аллы Новожениной «Дьявол носит Prada»
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Лекция диктора, режиссера и педагога Аллы Новожениной в зале Нарри (Sörnäisten rantatie 31 A). Увлекательный разбор законов мира моды, драматургии стиля и психологии экранных образов.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Лекция</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Практика">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Практика
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  Программа вакансий
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Практика и волонтерство через службу занятости (TE-toimisto)
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Logrus ry приглашает практикантов по направлениям: ассистент режиссера, костюмер/швея, художник по свету и звукорежиссер, помощник стилиста и координатор культурных проектов.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Стажировка</span></div>
          </article>
        </div>
      </section>
      <!-- Year 2023 -->
      <section class="year-group mb-14 sm:mb-16" data-year="2023">
        <div class="flex items-center gap-4 mb-6 sm:mb-8">
          <span class="bg-zinc-950 text-white text-xs sm:text-sm font-black tracking-widest uppercase px-4 py-1.5 rounded-full">
            2023
          </span>
          <div class="flex-1 h-px bg-zinc-200"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
          
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Театр">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Театр
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  Театральный репертуар
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Спектакль «Novecento» (Алессандро Барикко)
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                По легендарной пьесе Алессандро Барикко «Легенда о пианисте». Совместная постановка театра Logrus и студии DanceSport на сцене зала Narri (Sörnäisten rantatie 31).
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Драма / Танго</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Образование">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
