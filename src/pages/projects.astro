---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Проекты и инициативы — LOGRUS RY"
  description="Программа официальной практики TE-toimisto, молодежные инициативы и архив завершенных курсов общества LOGRUS ry в Хельсинки."
  lang="ru"
  ogImage="/images/card-involved.webp"
>
  <!-- Page Hero -->
  <section class="bg-white border-b border-zinc-200 py-12 sm:py-16 text-center">
    <div class="site-container">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight uppercase mb-3">
        Проекты и инициативы
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 max-w-xl mx-auto font-medium">
        Текущие возможности, программы интеграции и молодежные инициативы в Хельсинки.
      </p>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="py-14 sm:py-16">
    <div class="site-container max-w-4xl space-y-12">
      
      <!-- Project: TE-toimisto Practice -->
      <div class="bg-white border border-zinc-200 rounded-lg overflow-hidden shadow-sm flex flex-col md:flex-row">
        <div class="md:w-5/12 h-64 md:h-auto relative bg-zinc-950">
          <img
            src="/images/card-involved.webp"
            alt="Практика TE-toimisto"
            width="600"
            height="400"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="md:w-7/12 p-7 sm:p-9 flex flex-col justify-between">
          <div>
            <span class="text-xs font-black uppercase tracking-wider text-emerald-800 mb-1.5 block">
              Интеграция и практика
            </span>
            <h2 class="text-2xl font-black uppercase text-zinc-950 mb-3">
              Практика от TE-toimisto
            </h2>
            <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed mb-5">
              Официальная трудовая практика в сфере культуры и театра. Реальный сценический опыт в подготовке постановок, работе с костюмами и сценическим оборудованием с получением официального подтверждения/сертификата.
            </p>

            <div class="bg-zinc-50 border border-zinc-200 rounded p-4 mb-6 text-xs text-zinc-700 space-y-1.5">
              <div><strong>Направления:</strong> Швея/костюмер, помощник стилиста, сценический свет и звук</div>
              <div><strong>Условия:</strong> Гибкий график, официальный договор через TE-palvelut (työkokeilu / harjoittelu)</div>
              <div><strong>Офис координации:</strong> Sibeliuksenkatu 19B, Helsinki</div>
            </div>
          </div>

          <div class="flex flex-wrap gap-3">
            <a
              href="mailto:info@logrus.fi?subject=Резюме на практику TE-palvelut"
              class="inline-flex items-center gap-2 bg-zinc-950 text-white text-xs font-bold uppercase tracking-wider px-5 py-3 rounded hover:bg-zinc-800 transition-colors"
            >
              Отправить резюме &rarr;
            </a>
            <a
              href="/archive"
              class="inline-flex items-center gap-2 bg-transparent border border-zinc-300 text-zinc-800 text-xs font-bold uppercase tracking-wider px-5 py-3 rounded hover:bg-zinc-100 transition-colors"
            >
              Посмотреть завершённые курсы в архиве &rarr;
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
