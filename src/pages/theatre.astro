---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Театр Logrus — Репертуар и спектакли"
  description="Официальный театр LOGRUS: премьеры спектаклей, билеты, афиша и актерская труппа в Хельсинки."
  lang="ru"
  ogImage="/images/theatre-art.webp"
>
  <!-- Page Hero -->
  <section class="bg-white border-b border-zinc-200 py-12 sm:py-16 text-center">
    <div class="site-container">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight uppercase mb-3">
        Театр Logrus
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 max-w-xl mx-auto font-medium">
        Профессиональная сцена, премьеры и театральное искусство в Хельсинки.
      </p>
    </div>
  </section>

  <!-- Featured Production Section -->
  <section class="py-14 sm:py-16">
    <div class="site-container">
      <div class="bg-white border border-zinc-200 rounded-lg overflow-hidden shadow-sm grid grid-cols-1 lg:grid-cols-12 mb-14">
        <!-- Poster / Visual -->
        <div class="lg:col-span-6 relative bg-zinc-950 min-h-[380px] sm:min-h-[460px]">
          <img
            src="/images/theatre-art.webp"
            alt="Спектакль Новеченто"
            width="800"
            height="500"
            loading="eager"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover"
          />
        </div>

        <!-- Details -->
        <div class="lg:col-span-6 p-8 sm:p-12 flex flex-col justify-between">
          <div>
            <span class="text-xs font-black uppercase tracking-widest text-emerald-800 mb-2 block">
              Текущий репертуар
            </span>
            <h2 class="text-3xl sm:text-4xl font-black uppercase text-zinc-950 mb-3 leading-tight">
              NOVECENTO (1900)
            </h2>
            <p class="text-xs sm:text-sm font-bold text-zinc-500 uppercase tracking-wider mb-5">
              Алессандро Барикко • Режиссер: Аквиле Рузгите
            </p>
            <p class="text-sm text-zinc-700 leading-relaxed mb-6 font-normal">
              Удивительная музыкально-драматическая притча о гениальном пианисте, родившемся на борту трансатлантического океанского лайнера и ни разу в жизни не сошедшем на твердую землю.
            </p>

            <div class="bg-zinc-50 border border-zinc-200 rounded p-4 mb-6 text-xs text-zinc-700 space-y-1.5">
              <div><strong>Площадка:</strong> Сцена Narri (Sörnäisten rantatie 31, Helsinki)</div>
              <div><strong>Билеты:</strong> Biletti.fi и бронирование через театр</div>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href="https://www.teatterilogrus.fi/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 bg-zinc-950 text-white text-xs font-bold uppercase tracking-wider px-6 py-3.5 rounded hover:bg-zinc-800 transition-colors"
            >
              Перейти на сайт театра (teatterilogrus.fi) &rarr;
            </a>
            <a
              href="/archive"
              class="inline-flex items-center justify-center gap-2 bg-transparent border border-zinc-300 text-zinc-800 text-xs font-bold uppercase tracking-wider px-5 py-3.5 rounded hover:bg-zinc-100 transition-colors"
            >
              Архив постановок
            </a>
          </div>
        </div>
      </div>

      <!-- Other Repertoire Plays -->
      <div>
        <h3 class="text-2xl font-black uppercase tracking-tight text-zinc-950 mb-8 text-center sm:text-left">
          История постановок театра
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
          <!-- Play 1 -->
          <div class="bg-white border border-zinc-200 rounded-lg p-6 flex flex-col justify-between">
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Драма</span>
              <h4 class="text-lg font-bold uppercase text-zinc-950 mb-2">Молодая хозяйка Нискавуори</h4>
              <p class="text-xs text-zinc-600 leading-relaxed mb-4">
                Классическая финская драма Хеллы Вуолийоки о борьбе традиций, любви и долга в родовом поместье Нискавуори.
              </p>
            </div>
            <a href="/archive" class="text-xs font-bold text-zinc-900 hover:underline inline-flex items-center gap-1">
              Подробнее в архиве &rarr;
            </a>
          </div>

          <!-- Play 2 -->
          <div class="bg-white border border-zinc-200 rounded-lg p-6 flex flex-col justify-between">
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Комедия</span>
              <h4 class="text-lg font-bold uppercase text-zinc-950 mb-2">SILVIA</h4>
              <p class="text-xs text-zinc-600 leading-relaxed mb-4">
                Остроумная и трогательная бродвейская комедия А. Р. Герни о любви, семье и неожиданных поворотах судьбы.
              </p>
            </div>
            <a href="/archive" class="text-xs font-bold text-zinc-900 hover:underline inline-flex items-center gap-1">
              Подробнее в архиве &rarr;
            </a>
          </div>

          <!-- Play 3 -->
          <div class="bg-white border border-zinc-200 rounded-lg p-6 flex flex-col justify-between">
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Притча</span>
              <h4 class="text-lg font-bold uppercase text-zinc-950 mb-2">Очень простая история</h4>
              <p class="text-xs text-zinc-600 leading-relaxed mb-4">
                Трогательная история любви, верности и человеческих отношений глазами обитателей деревенского двора.
              </p>
            </div>
            <a href="/archive" class="text-xs font-bold text-zinc-900 hover:underline inline-flex items-center gap-1">
              Подробнее в архиве &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>