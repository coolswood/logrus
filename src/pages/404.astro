---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Страница не найдена | LOGRUS RY"
  description="Запрашиваемая страница не существует или была перемещена."
  lang="ru"
>
  <section class="flex-1 flex items-center justify-center py-16 sm:py-24 text-center">
    <div class="site-container max-w-xl mx-auto">
      <span class="text-xs font-black uppercase tracking-widest text-zinc-400 block mb-2">
        Ошибка 404
      </span>
      <h1 class="text-6xl sm:text-7xl font-black uppercase text-zinc-950 tracking-tight mb-4 leading-none">
        404
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 mb-8 font-medium">
        Страница, которую вы ищете, не существует или была перемещена.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/"
          class="bg-zinc-950 text-white text-xs font-bold uppercase tracking-wider px-6 py-3.5 rounded hover:bg-zinc-800 transition-colors"
        >
          На главную страницу &rarr;
        </a>
        <a
          href="/about"
          class="bg-zinc-100 border border-zinc-300 text-zinc-800 text-xs font-bold uppercase tracking-wider px-6 py-3.5 rounded hover:bg-zinc-200 transition-colors"
        >
          Контакты и площадки
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
