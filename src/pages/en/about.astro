---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="About Us & Contacts — LOGRUS RY"
  description="Mission of LOGRUS ry youth support society in Finland, team leadership, venues and contact details."
  lang="en"
>
  <!-- Page Hero -->
  <section class="bg-white border-b border-zinc-200 py-12 sm:py-16 text-center">
    <div class="site-container">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight uppercase mb-3">
        About Us
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 max-w-xl mx-auto font-medium">
        International Society for the Support of Youth Initiatives «LOGRUS ry» in Helsinki.
      </p>
    </div>
  </section>

  <!-- Main Content Section -->
  <section class="py-14 sm:py-16">
    <div class="site-container">
      <!-- Mission & Contacts Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 mb-16">
        <!-- Left: Mission & Details -->
        <div class="lg:col-span-7 flex flex-col gap-6">
          <div>
            <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight uppercase text-zinc-950 mb-4">
              Our Mission
            </h2>
            <div class="space-y-4 text-sm sm:text-base text-zinc-700 leading-relaxed font-normal">
              <p>
                <strong class="font-bold text-zinc-950">LOGRUS ry</strong> is a non-governmental organization created to bring young people together, cultivate creative abilities, foster intercultural integration, and support stage performance initiatives across Finland.
              </p>
              <p>
                We produce cultural and theatrical shows, conduct regular skill workshops, run dance and art studios, and organize youth festivals and creative camps.
              </p>
              <p>
                We actively collaborate with Finnish cultural centers and youth facilities (Caisa, Kanneltalo, Nuorisotilat Kontula) and offer certified workplace trial and internship programs through TE-palvelut.
              </p>
            </div>
          </div>

          <!-- History / Milestones -->
          <div class="bg-white border border-zinc-200 rounded-lg p-6 sm:p-8">
            <h3 class="text-lg font-bold text-zinc-950 uppercase tracking-wide mb-3">
              Key Activity Areas
            </h3>
            <ul class="space-y-2.5 text-xs sm:text-sm text-zinc-600">
              <li class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-zinc-950 shrink-0"></span>
                <span>Theatrical productions and festival tours across Finland and the Baltics</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-zinc-950 shrink-0"></span>
                <span>Free creative studios and defile workshops for youth aged 14 to 25</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-zinc-950 shrink-0"></span>
                <span>Official workplace trial (työkokeilu / harjoittelu) through TE-palvelut</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-zinc-950 shrink-0"></span>
                <span>International art festivals («Gloria Star», «Art-Planet»)</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Right: Contact Box -->
        <div class="lg:col-span-5">
          <div class="bg-white border border-zinc-200 rounded-lg p-7 sm:p-9 sticky top-28 shadow-sm">
            <h3 class="text-xl font-black uppercase tracking-wide mb-6 text-zinc-950">
              Contacts
            </h3>

            <div class="space-y-5 text-sm text-zinc-700">
              <!-- Location -->
              <div class="flex items-start gap-3.5">
                <svg class="h-5 w-5 text-zinc-950 shrink-0 mt-0.5" width="20" height="20" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <div>
                  <strong class="font-bold text-zinc-950 block mb-1">Venues:</strong>
                  <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
                    • Narri Stage: Sörnäisten rantatie 31, Helsinki<br>
                    • Kontula Youth Centre: Ostostie 4, Helsinki<br>
                    • Registered Office: Sibeliuksenkatu 19B, Helsinki
                  </p>
                </div>
              </div>

              <!-- Email -->
              <div class="flex items-start gap-3.5">
                <svg class="h-5 w-5 text-zinc-950 shrink-0 mt-0.5" width="20" height="20" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <div>
                  <strong class="font-bold text-zinc-950 block mb-1">Email:</strong>
                  <a href="mailto:info@logrus.fi" class="text-xs sm:text-sm text-zinc-900 hover:underline">
                    info@logrus.fi
                  </a>
                </div>
              </div>

              <!-- Phone -->
              <div class="flex items-start gap-3.5">
                <svg class="h-5 w-5 text-zinc-950 shrink-0 mt-0.5" width="20" height="20" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <div>
                  <strong class="font-bold text-zinc-950 block mb-1">Phone:</strong>
                  <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
                    <a href="tel:+358458977777" class="hover:underline text-zinc-900">+358 45 897 7777</a> (Kristina)<br>
                    <a href="tel:+358451537303" class="hover:underline text-zinc-900">+358 45 153 7303</a> (Elena)
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- TE-toimisto Collaboration Section -->
      <div id="involved" class="bg-white border border-zinc-200 rounded-lg overflow-hidden grid grid-cols-1 md:grid-cols-12 items-center">
        <div class="md:col-span-5 h-72 md:h-full relative bg-zinc-900">
          <img
            src="/images/card-involved.webp"
            alt="Internship at Logrus ry"
            width="600"
            height="400"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="md:col-span-7 p-8 sm:p-10">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-800 mb-2 block">
            Practice & Partnerships
          </span>
          <h3 class="text-2xl font-black uppercase text-zinc-950 mb-3 leading-tight">
            Work Trial & Internship via TE-palvelut
          </h3>
          <p class="text-sm text-zinc-600 mb-4 leading-relaxed">
            We offer official job trials (työkokeilu) and vocational training for tailors, costume assistants, sound and lighting technicians, and project coordinators. A wonderful opportunity to gain authentic experience in the Finnish cultural scene.
          </p>
          <a
            href="mailto:info@logrus.fi?subject=Inquiry for TE-palvelut Internship"
            class="inline-flex items-center gap-2 bg-zinc-950 text-white text-xs font-bold uppercase tracking-wider px-5 py-3 rounded hover:bg-zinc-800 transition-colors"
          >
            Apply for Internship &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
