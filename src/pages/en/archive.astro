---
import BaseLayout from '@/layouts/BaseLayout.astro';

const archiveItems2025_2026 = [
  {
    tag: 'Theatre Play',
    title: '«NOVECENTO»',
    date: 'November 2025',
    image: '/images/card-theatre.webp',
    description: 'Stage production based on the novella by Alessandro Baricco in collaboration with DanceSport Studio. The story of a legendary pianist born at sea.',
    meta: [
      { label: 'Director', val: 'Akvile Ruzgyte' },
      { label: 'Venue', val: 'Narri Stage, Sörnäisten rantatie 31, Helsinki' },
    ],
  },
  {
    tag: 'Youth Workshops',
    title: 'Defile & Dance Studios',
    date: 'Season 2025 — 2026',
    image: '/images/card-initiatives.webp',
    description: 'Free creative classes for youth aged 14–25. Stage movement, traditional costume defile and gala performance preparation.',
    meta: [
      { label: 'Location', val: 'Nuorisotalo Kontula, Ostostie 4, Helsinki' },
      { label: 'Status', val: 'Successfully completed' },
    ],
  },
  {
    tag: 'Theatre Play',
    title: '«SILVIA»',
    date: '2026',
    image: '/images/card-archive.webp',
    description: 'A witty and heartfelt Broadway comedy by A. R. Gurney about friendship, family, and unexpected bonds.',
    meta: [
      { label: 'Theatre', val: 'Logrus Teatteri' },
      { label: 'Stage', val: 'Narrin näyttämö' },
    ],
  },
];

const archiveItemsPast = [
  {
    tag: 'Family Show',
    title: '«Mystery of the Lost Ring»',
    date: 'Season 2024',
    image: '/images/card-about.webp',
    description: 'Interactive family performance by the youth theatre ensemble of the Helmi Center based on classic English tales.',
    meta: [
      { label: 'Organizer', val: 'Logrus Ry / Helmi-keskus' },
    ],
  },
  {
    tag: 'Festival & Camp',
    title: 'Social Environment & Integration',
    date: '2022 — 2024',
    image: '/images/card-involved.webp',
    description: 'Series of intercultural events, language exchange sessions, and youth integration camps across Finland.',
    meta: [
      { label: 'Partners', val: 'Caisa, Kanneltalo, TE-toimisto' },
    ],
  },
  {
    tag: 'Drama',
    title: '«Young Mistress of Niskavuori»',
    date: '2021 — 2022',
    image: '/images/niskavuori.webp',
    description: 'Classic Finnish drama by Hella Wuolijoki about tradition, duty, and passion at the Niskavuori estate.',
    meta: [
      { label: 'Theatre', val: 'Logrus Teatteri' },
    ],
  },
  {
    tag: 'Fashion Show',
    title: '«The Hipsters» Runway Show',
    date: '2019',
    image: '/images/fashion-hipsters.webp',
    description: 'Youth fashion performance featuring vintage and stylized costumes tailored in the Logrus workshop.',
    meta: [
      { label: 'Organizer', val: 'Logrus ry' },
    ],
  },
  {
    tag: 'Festival',
    title: 'International Festival «Art-Planet»',
    date: '2016 — 2018',
    image: '/images/art-planet-2020.webp',
    description: 'Annual multigenre youth festival uniting performing ensembles from across the Baltic Sea region.',
    meta: [
      { label: 'Venue', val: 'Helsinki' },
    ],
  },
  {
    tag: 'Contest',
    title: '«Gloria Star» Talent Competition',
    date: '2013 — 2015',
    image: '/images/spektr-2016.webp',
    description: 'Vocal and choreographic competition for emerging artists with international jury and masterclasses.',
    meta: [
      { label: 'Organizer', val: 'Logrus ry' },
    ],
  },
];
---

<BaseLayout
  title="Archive of Events & Shows — LOGRUS RY"
  description="Archive of theatrical productions, festivals Gloria Star, Art-Planet, and youth projects of LOGRUS ry since 2012."
  lang="en"
  ogImage="/images/card-archive.webp"
>
  <!-- Page Hero -->
  <section class="bg-white border-b border-zinc-200 py-12 sm:py-16 text-center">
    <div class="site-container">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight uppercase mb-3">
        Event Archive
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 max-w-xl mx-auto font-medium">
        Chronicle of stage plays, international festivals, fashion shows, and youth projects since 2012.
      </p>
    </div>
  </section>

  <!-- Archive Timeline Section -->
  <section class="py-14 sm:py-16">
    <div class="site-container">
      
      <!-- Section: 2025 - 2026 -->
      <div class="mb-16">
        <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-zinc-950 mb-8 border-b-2 border-zinc-950 pb-2 inline-block">
          2025 — 2026
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
          {archiveItems2025_2026.map((item) => (
            <div class="bg-white border border-zinc-200 rounded-lg overflow-hidden flex flex-col shadow-sm transition-transform duration-200 hover:-translate-y-1">
              <div class="h-56 relative bg-zinc-900 overflow-hidden">
                <span class="absolute top-3 left-3 bg-zinc-950/80 backdrop-blur-xs text-white text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded z-10">
                  {item.tag}
                </span>
                <img
                  src={item.image}
                  alt={item.title}
                  width="480"
                  height="320"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                />
              </div>
              <div class="p-6 flex flex-col flex-1 justify-between">
                <div>
                  <div class="text-xs font-bold text-zinc-400 mb-1.5">{item.date}</div>
                  <h3 class="text-lg font-black uppercase text-zinc-950 mb-2.5 leading-snug">{item.title}</h3>
                  <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed mb-4">{item.description}</p>
                </div>
                <div class="pt-3 border-t border-zinc-100 text-xs text-zinc-600 space-y-1">
                  {item.meta.map((m) => (
                    <div><strong>{m.label}:</strong> {m.val}</div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Section: Past Seasons -->
      <div>
        <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-zinc-950 mb-8 border-b-2 border-zinc-950 pb-2 inline-block">
          Earlier Repertoire & Projects
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
          {archiveItemsPast.map((item) => (
            <div class="bg-white border border-zinc-200 rounded-lg overflow-hidden flex flex-col shadow-sm transition-transform duration-200 hover:-translate-y-1">
              <div class="h-56 relative bg-zinc-900 overflow-hidden">
                <span class="absolute top-3 left-3 bg-zinc-950/80 backdrop-blur-xs text-white text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded z-10">
                  {item.tag}
                </span>
                <img
                  src={item.image}
                  alt={item.title}
                  width="480"
                  height="320"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                />
              </div>
              <div class="p-6 flex flex-col flex-1 justify-between">
                <div>
                  <div class="text-xs font-bold text-zinc-400 mb-1.5">{item.date}</div>
                  <h3 class="text-lg font-black uppercase text-zinc-950 mb-2.5 leading-snug">{item.title}</h3>
                  <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed mb-4">{item.description}</p>
                </div>
                <div class="pt-3 border-t border-zinc-100 text-xs text-zinc-600 space-y-1">
                  {item.meta.map((m) => (
                    <div><strong>{m.label}:</strong> {m.val}</div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
