---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Chronicle and Archive of Events — LOGRUS RY"
  description="Archive of theatrical productions, festivals, fashion shows, workshops, and youth initiatives by Logrus ry since 2010."
  lang="en"
  ogImage="/images/niskavuori.webp"
>
  <!-- Page Hero -->
  <section class="bg-white border-b border-zinc-200 py-12 sm:py-16 text-center">
    <div class="site-container">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight uppercase mb-3 text-zinc-950">
        Archive of Events
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 max-w-2xl mx-auto font-medium leading-relaxed">
        Chronicle of performances, festivals, fashion showcases, masterclasses, and youth initiatives since 2010.
      </p>
    </div>
  </section>

  <!-- Controls: Search & Category Filter -->
  <section class="py-8 bg-[#fcfbfa] border-b border-zinc-200/80 sticky top-[73px] z-30 backdrop-blur-md bg-[#fcfbfa]/95">
    <div class="site-container flex flex-col md:flex-row items-center justify-between gap-4">
      
      <!-- Search Input -->
      <div class="w-full md:w-80 relative">
        <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-zinc-400 pointer-events-none fill-none stroke-current stroke-2" width="16" height="16" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <input
          type="text"
          id="archiveSearch"
          placeholder="Search by title or description..."
          aria-label="Search by title or description..."
          class="w-full pl-10 pr-4 py-2.5 bg-white border border-zinc-200 rounded-lg text-xs font-semibold text-zinc-950 placeholder-zinc-400 focus:outline-none focus:border-zinc-950 focus:ring-1 focus:ring-zinc-950 transition-all shadow-xs"
        />
      </div>

      <!-- Category Filter Buttons -->
      <div class="flex flex-wrap items-center gap-2" id="categoryFilters">
        <button class="filter-btn active bg-zinc-950 text-white text-xs font-black uppercase tracking-wider px-4 py-2 rounded-full transition-all cursor-pointer shadow-xs" data-filter="all">All Entries</button>
        <button class="filter-btn bg-zinc-100 text-zinc-700 hover:bg-zinc-200 hover:text-zinc-950 text-xs font-black uppercase tracking-wider px-4 py-2 rounded-full transition-all cursor-pointer" data-filter="Theatre">Theatre</button>
        <button class="filter-btn bg-zinc-100 text-zinc-700 hover:bg-zinc-200 hover:text-zinc-950 text-xs font-black uppercase tracking-wider px-4 py-2 rounded-full transition-all cursor-pointer" data-filter="Fashion">Fashion</button>
        <button class="filter-btn bg-zinc-100 text-zinc-700 hover:bg-zinc-200 hover:text-zinc-950 text-xs font-black uppercase tracking-wider px-4 py-2 rounded-full transition-all cursor-pointer" data-filter="Festivals">Festivals</button>
        <button class="filter-btn bg-zinc-100 text-zinc-700 hover:bg-zinc-200 hover:text-zinc-950 text-xs font-black uppercase tracking-wider px-4 py-2 rounded-full transition-all cursor-pointer" data-filter="Events">Events</button>
        <button class="filter-btn bg-zinc-100 text-zinc-700 hover:bg-zinc-200 hover:text-zinc-950 text-xs font-black uppercase tracking-wider px-4 py-2 rounded-full transition-all cursor-pointer" data-filter="Education">Education</button>
        <button class="filter-btn bg-zinc-100 text-zinc-700 hover:bg-zinc-200 hover:text-zinc-950 text-xs font-black uppercase tracking-wider px-4 py-2 rounded-full transition-all cursor-pointer" data-filter="Studios">Studios</button>

      </div>

    </div>
  </section>

  <!-- Archive Content Stream -->
  <section class="py-12 sm:py-16 flex-1">
    <div class="site-container" id="archiveList">
      
      <!-- Year 2025 -->
      <section class="year-group mb-14 sm:mb-16" data-year="2025">
        <div class="flex items-center gap-4 mb-6 sm:mb-8">
          <span class="bg-zinc-950 text-white text-xs sm:text-sm font-black tracking-widest uppercase px-4 py-1.5 rounded-full">
            2025
          </span>
          <div class="flex-1 h-px bg-zinc-200"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
          
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Theatre">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Theatre
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  03.02.2025
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                🎭 Open Theatre Group at Logrus Theatre
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                The creative team of Logrus Theatre opens its doors to the fascinating world of theatrical art! A unique opportunity to immerse yourself in the magic of the stage, unleash your creative potential, and master the art of acting.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Group Enrollment</span></div>
          </article>
        </div>
      </section>
      <!-- Year 2024 -->
      <section class="year-group mb-14 sm:mb-16" data-year="2024">
        <div class="flex items-center gap-4 mb-6 sm:mb-8">
          <span class="bg-zinc-950 text-white text-xs sm:text-sm font-black tracking-widest uppercase px-4 py-1.5 rounded-full">
            2024
          </span>
          <div class="flex-1 h-px bg-zinc-200"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
          
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Events">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Events
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  07.12.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Video Report: "Christmas Gatherings" in Helsinki
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                A joint event by Logrus ry and Encanta Oy. An extraordinary concert and holiday celebration: Sergey Florov ("shaman with a tambourine") opened the evening, filling the hall with warmth and New Year magic.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Celebration</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Theatre">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Theatre
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  15.09.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Family Play: "The Mystery of the Missing Ring"
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                The Youth Theatre of the Helmi Center and Logrus Ry presented an engaging family play based on classic English fairy tales. We thank all participants and spectators for their support and magical atmosphere!
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Premiere</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Festivals">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Festivals
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  03.08.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Medieval Fair in Kouvola
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Logrus Ry took part in the traditional Medieval Fair in Kouvola. Historical dresses and handcrafted men's shirts made of natural linen and cotton were showcased.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Fair</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Events">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Events
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  10.05.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Helsinki Walk with Alexandre Vassiliev
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                A pleasant spring walk and informal gathering in Helsinki with world-renowned fashion historian and art scholar Alexandre Vassiliev, organized with Logrus ry and Encanta Oy.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Meeting</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Theatre">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Theatre
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  07.04.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Play "La Belle Vie" on Tour in Jyväskylä
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Logrus Theatre on tour in Jyväskylä with Jean Anouilh's revolutionary tragicomedy "La Belle Vie" (directed by Akvilė Ruzgaitė). Heartfelt thanks to our audience and partners for the warm reception!
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Tour</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Fashion">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Fashion
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  09.02.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Costume & Gown Rental for "Vanhat Tanssit" Ball
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Traditional high school Vanhat tanssit ball in Helsinki! Logrus ry and Encanta Oy offer ballroom gowns, tailcoats, and accessories at accessible prices with custom fittings.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Costumes</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Studios">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Studios
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  03.02.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Open Flamenco Dance Workshop
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Free introductory lesson "Flamenco for Beginners" led by instructor Raisat Gessel at the Luuppi youth center (Kontula, Helsinki). Exploring core rhythms, posture, and expressive dance grace.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Workshop</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Education">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Education
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  20.01.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Alla Novozhenina's Lecture Series: "The Devil Wears Prada"
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                A lecture by voice artist, director, and educator Alla Novozhenina at the Narri Hall (Sörnäisten rantatie 31 A). An engaging analysis of the fashion world, stylistic dramaturgy, and screen psychology.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Lecture</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Internship">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Internship
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  Vocational Program
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Internship and Volunteering via Employment Services (TE-toimisto)
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Logrus ry welcomes trainees in: assistant director, costume designer/tailor, lighting and sound engineer, stylist assistant, and cultural project coordinator.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Internship</span></div>
          </article>
        </div>
      </section>
      <!-- Year 2023 -->
      <section class="year-group mb-14 sm:mb-16" data-year="2023">
        <div class="flex items-center gap-4 mb-6 sm:mb-8">
          <span class="bg-zinc-950 text-white text-xs sm:text-sm font-black tracking-widest uppercase px-4 py-1.5 rounded-full">
            2023
          </span>
          <div class="flex-1 h-px bg-zinc-200"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
          
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Theatre">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Theatre
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  Repertoire Season
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Play "Novecento" (Alessandro Baricco)
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Based on Alessandro Baricco's legendary monologue "The Legend of 1900". A joint production by Logrus Theatre and DanceSport Studio on stage at Narri (Sörnäisten rantatie 31).
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Drama / Tango</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Education">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Education
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  24.09.2023
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Workshop: "Public Speaking for Adults"
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Practical coaching on speech technique, overcoming stage fright, and confident presentation by Alla Novozhenina for community activists and theatre participants.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Workshop</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Photo & Art">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Photo & Art
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  08.05.2023
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Photoshoot: "Alice and Woland's Company"
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Artistic photoshoot series by Logrus Theatre inspired by the mystical atmosphere of Bulgakov's "The Master and Margarita". A synthesis of vintage fashion, mystery, and portrait drama.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Photo Project</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Festivals">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Festivals
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  22.01.2023
