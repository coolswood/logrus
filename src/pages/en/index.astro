---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeaturedCard from '@/components/FeaturedCard.astro';
---

<BaseLayout
  title="LOGRUS RY — International Youth Support Society"
  description="Official website of LOGRUS RY in Finland: theatre, youth creative workshops, dance courses, festivals, and practical internships."
  lang="en"
>
  <!-- Hero Section -->
  <section class="text-center pt-10 pb-12 sm:pt-14 sm:pb-16">
    <div class="site-container">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight uppercase mb-2 leading-none">
        LOGRUS RY
      </h1>
      <div class="text-lg sm:text-2xl font-extrabold tracking-[0.15em] uppercase text-zinc-800 mb-5">
        THEATRE & CULTURE ASSOCIATION
      </div>
      <div class="w-28 h-0.5 bg-zinc-950 mx-auto mb-5"></div>
      <p class="text-xs sm:text-sm font-semibold tracking-widest uppercase text-zinc-600 max-w-xl mx-auto">
        International Youth Support Society
      </p>
    </div>
  </section>

  <!-- 2x2 Cards Grid -->
  <section class="pb-20">
    <div class="site-container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-7 sm:gap-8">
        <!-- THEATRE -->
        <FeaturedCard
          title="THEATRE"
          description="Official website of Logrus Theatre: repertoire, performances, cast and premieres"
          image="/images/card-theatre.webp"
          href="https://www.teatterilogrus.fi/"
          external={true}
          icon="theatre"
          variant="dark"
          priority={true}
        />

        <!-- PROJECTS -->
        <FeaturedCard
          title="PROJECTS"
          description="Workshops, youth initiatives, stage prop rentals, and more"
          image="/images/card-initiatives.webp"
          href="/en/projects"
          icon="projects"
          variant="light"
          priority={true}
        />

        <!-- ARCHIVE -->
        <FeaturedCard
          title="ARCHIVE"
          description="History of productions, past events, festival highlights, and gallery"
          image="/images/card-archive.webp"
          href="/en/archive"
          icon="archive"
          variant="light"
        />

        <!-- ABOUT -->
        <FeaturedCard
          title="ABOUT US"
          description="Our mission, values, team contacts, and TE-office internships"
          image="/images/card-about.webp"
          href="/en/about"
          icon="about"
          variant="light"
        />
      </div>
    </div>
  </section>
</BaseLayout>
