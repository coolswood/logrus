---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Projects & Studios — LOGRUS RY"
  description="Free youth dance and defile studios in Helsinki (Kontula), creative workshops and TE-office internships."
  lang="en"
  ogImage="/images/card-initiatives.webp"
>
  <!-- Page Hero -->
  <section class="bg-white border-b border-zinc-200 py-12 sm:py-16 text-center">
    <div class="site-container">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight uppercase mb-3">
        Projects & Studios
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 max-w-xl mx-auto font-medium">
        Creative opportunities, free youth studios, and vocational training in Helsinki.
      </p>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="py-14 sm:py-16">
    <div class="site-container max-w-4xl space-y-12">
      
      <!-- Project 1: Kontula Studios -->
      <div class="bg-white border border-zinc-200 rounded-lg overflow-hidden shadow-sm flex flex-col md:flex-row">
        <div class="md:w-5/12 h-64 md:h-auto relative bg-zinc-950">
          <img
            src="/images/card-initiatives.webp"
            alt="Dance and Defile Studios"
            width="600"
            height="400"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="md:w-7/12 p-7 sm:p-9 flex flex-col justify-between">
          <div>
            <span class="text-xs font-black uppercase tracking-wider text-emerald-800 mb-1.5 block">
              Free for Youth aged 14–25
            </span>
            <h2 class="text-2xl font-black uppercase text-zinc-950 mb-3">
              Defile & Dance Studios
            </h2>
            <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed mb-5">
              Regular classes in body plasticity, runway defile, modern movement, and traditional dance. Build stage confidence, poise, and take part in gala performances.
            </p>

            <div class="bg-zinc-50 border border-zinc-200 rounded p-4 mb-6 text-xs text-zinc-700 space-y-1.5">
              <div><strong>Location:</strong> Nuorisotalo Kontula (Ostostie 4, Helsinki)</div>
              <div><strong>Cost:</strong> Free of charge (supported by City of Helsinki)</div>
              <div><strong>Curator contact:</strong> +358 45 897 7777</div>
            </div>
          </div>

          <div class="flex flex-wrap gap-3">
            <a
              href="https://wa.me/358458977777"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-emerald-800 text-white text-xs font-bold uppercase tracking-wider px-5 py-3 rounded hover:bg-emerald-900 transition-colors"
            >
              Contact via WhatsApp &rarr;
            </a>
            <a
              href="mailto:info@logrus.fi?subject=Sign up for Youth Studio in Kontula"
              class="inline-flex items-center gap-2 bg-zinc-950 text-white text-xs font-bold uppercase tracking-wider px-5 py-3 rounded hover:bg-zinc-800 transition-colors"
            >
              Send an Email
            </a>
          </div>
        </div>
      </div>

      <!-- Project 2: TE-Office Internship -->
      <div class="bg-white border border-zinc-200 rounded-lg overflow-hidden shadow-sm flex flex-col md:flex-row">
        <div class="md:w-5/12 h-64 md:h-auto relative bg-zinc-950">
          <img
            src="/images/card-involved.webp"
            alt="TE-Office Work Trial"
            width="600"
            height="400"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="md:w-7/12 p-7 sm:p-9 flex flex-col justify-between">
          <div>
            <span class="text-xs font-black uppercase tracking-wider text-emerald-800 mb-1.5 block">
              Integration & Careers
            </span>
            <h2 class="text-2xl font-black uppercase text-zinc-950 mb-3">
              Internship via TE-palvelut
            </h2>
            <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed mb-5">
              Official practical work experience in stage arts, costume tailoring, lighting and audio engineering, with official certification for your resume.
            </p>

            <div class="bg-zinc-50 border border-zinc-200 rounded p-4 mb-6 text-xs text-zinc-700 space-y-1.5">
              <div><strong>Roles:</strong> Costume maker, stylist assistant, sound & lighting tech</div>
              <div><strong>Agreement:</strong> Official contract via TE-palvelut (työkokeilu / harjoittelu)</div>
              <div><strong>Office:</strong> Sibeliuksenkatu 19B, Helsinki</div>
            </div>
          </div>

          <div class="flex flex-wrap gap-3">
            <a
              href="mailto:info@logrus.fi?subject=Resume for TE-palvelut Internship"
              class="inline-flex items-center gap-2 bg-zinc-950 text-white text-xs font-bold uppercase tracking-wider px-5 py-3 rounded hover:bg-zinc-800 transition-colors"
            >
              Send CV / Inquire &rarr;
            </a>
            <a
              href="/en/archive"
              class="inline-flex items-center gap-2 bg-transparent border border-zinc-300 text-zinc-800 text-xs font-bold uppercase tracking-wider px-5 py-3 rounded hover:bg-zinc-100 transition-colors"
            >
              Archive & Past Events
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
