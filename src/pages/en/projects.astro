---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Projects & Initiatives — LOGRUS RY"
  description="Official practical training via TE-palvelut, youth initiatives and archived courses of LOGRUS ry in Helsinki."
  lang="en"
  ogImage="/images/card-involved.webp"
>
  <!-- Page Hero -->
  <section class="bg-white border-b border-zinc-200 py-12 sm:py-16 text-center">
    <div class="site-container">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight uppercase mb-3">
        Projects & Initiatives
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 max-w-xl mx-auto font-medium">
        Current opportunities, integration programs and youth initiatives in Helsinki.
      </p>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="py-14 sm:py-16">
    <div class="site-container max-w-4xl space-y-12">
      
      <!-- Project: TE-Office Internship -->
      <div class="bg-white border border-zinc-200 rounded-lg overflow-hidden shadow-sm flex flex-col md:flex-row">
        <div class="md:w-5/12 h-64 md:h-auto relative bg-zinc-950">
          <img
            src="/images/card-involved.webp"
            alt="TE-Office Work Trial"
            width="600"
            height="400"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="md:w-7/12 p-7 sm:p-9 flex flex-col justify-between">
          <div>
            <span class="text-xs font-black uppercase tracking-wider text-emerald-800 mb-1.5 block">
              Integration & Internship
            </span>
            <h2 class="text-2xl font-black uppercase text-zinc-950 mb-3">
              Work Experience via TE-Office
            </h2>
            <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed mb-5">
              Official practical training in cultural and theatre production. Hands-on experience in show production, costume tailoring, lighting and sound technology with official certification.
            </p>

            <div class="bg-zinc-50 border border-zinc-200 rounded p-4 mb-6 text-xs text-zinc-700 space-y-1.5">
              <div><strong>Roles:</strong> Seamstress/costume maker, assistant stylist, stage light & sound</div>
              <div><strong>Conditions:</strong> Flexible schedule, official agreement via TE-palvelut (työkokeilu / harjoittelu)</div>
              <div><strong>Coordination:</strong> Sibeliuksenkatu 19B, Helsinki</div>
            </div>
          </div>

          <div class="flex flex-wrap gap-3">
            <a
              href="mailto:info@logrus.fi?subject=Resume for TE-palvelut Internship"
              class="inline-flex items-center gap-2 bg-zinc-950 text-white text-xs font-bold uppercase tracking-wider px-5 py-3 rounded hover:bg-zinc-800 transition-colors"
            >
              Send CV / Inquire &rarr;
            </a>
            <a
              href="/en/archive"
              class="inline-flex items-center gap-2 bg-transparent border border-zinc-300 text-zinc-800 text-xs font-bold uppercase tracking-wider px-5 py-3 rounded hover:bg-zinc-100 transition-colors"
            >
              View archived courses & events &rarr;
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
