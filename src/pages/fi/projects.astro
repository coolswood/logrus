---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Projektit ja studiot — LOGRUS RY"
  description="Maksuttomat nuorten tanssi- ja catwalk-studiot Helsingissä (Kontula), nuorisoaloitteet ja TE-toimiston harjoittelut."
  lang="fi"
  ogImage="/images/card-initiatives.webp"
>
  <!-- Page Hero -->
  <section class="bg-white border-b border-zinc-200 py-12 sm:py-16 text-center">
    <div class="site-container">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight uppercase mb-3">
        Projektit ja studiot
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 max-w-xl mx-auto font-medium">
        Luovia mahdollisuuksia, maksuttomia nuorten studioita ja ammatillista harjoittelua Helsingissä.
      </p>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="py-14 sm:py-16">
    <div class="site-container max-w-4xl space-y-12">
      
      <!-- Project 1: Kontula Studios -->
      <div class="bg-white border border-zinc-200 rounded-lg overflow-hidden shadow-sm flex flex-col md:flex-row">
        <div class="md:w-5/12 h-64 md:h-auto relative bg-zinc-950">
          <img
            src="/images/card-initiatives.webp"
            alt="Tanssi- ja catwalk-studiot"
            width="600"
            height="400"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="md:w-7/12 p-7 sm:p-9 flex flex-col justify-between">
          <div>
            <span class="text-xs font-black uppercase tracking-wider text-emerald-800 mb-1.5 block">
              Maksuton 14–25-vuotiaille nuorille
            </span>
            <h2 class="text-2xl font-black uppercase text-zinc-950 mb-3">
              Catwalk- ja tanssistudiot
            </h2>
            <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed mb-5">
              Säännölliset tunnit kehittävät esiintymisvarmuutta, ryhtiä, modernia ja perinteistä tanssia sekä catwalk-kävelyä. Valmistautuminen esityksiin ja juhlagaalaan.
            </p>

            <div class="bg-zinc-50 border border-zinc-200 rounded p-4 mb-6 text-xs text-zinc-700 space-y-1.5">
              <div><strong>Toimipiste:</strong> Kontulan nuorisotalo (Ostostie 4, Helsinki)</div>
              <div><strong>Hinta:</strong> Maksuton (Helsingin kaupungin tuella)</div>
              <div><strong>Kuraattori:</strong> +358 45 897 7777</div>
            </div>
          </div>

          <div class="flex flex-wrap gap-3">
            <a
              href="https://wa.me/358458977777"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-emerald-800 text-white text-xs font-bold uppercase tracking-wider px-5 py-3 rounded hover:bg-emerald-900 transition-colors"
            >
              Ilmoittaudu WhatsAppissa &rarr;
            </a>
            <a
              href="mailto:info@logrus.fi?subject=Ilmoittautuminen Kontulan nuorisostudioon"
              class="inline-flex items-center gap-2 bg-zinc-950 text-white text-xs font-bold uppercase tracking-wider px-5 py-3 rounded hover:bg-zinc-800 transition-colors"
            >
              Lähetä sähköpostia
            </a>
          </div>
        </div>
      </div>

      <!-- Project 2: TE-Office Internship -->
      <div class="bg-white border border-zinc-200 rounded-lg overflow-hidden shadow-sm flex flex-col md:flex-row">
        <div class="md:w-5/12 h-64 md:h-auto relative bg-zinc-950">
          <img
            src="/images/card-involved.webp"
            alt="TE-palveluiden työkokeilu"
            width="600"
            height="400"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="md:w-7/12 p-7 sm:p-9 flex flex-col justify-between">
          <div>
            <span class="text-xs font-black uppercase tracking-wider text-emerald-800 mb-1.5 block">
              Kotoutuminen ja ura
            </span>
            <h2 class="text-2xl font-black uppercase text-zinc-950 mb-3">
              Harjoittelu TE-toimiston kautta
            </h2>
            <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed mb-5">
              Virallinen työkokeilu ja harjoittelu kulttuuri- ja teatterialalla. Käytännön kokemusta esitysten valmistelusta, puvustuksesta sekä valo- ja äänitekniikasta virallisella työtodistuksella.
            </p>

            <div class="bg-zinc-50 border border-zinc-200 rounded p-4 mb-6 text-xs text-zinc-700 space-y-1.5">
              <div><strong>Tehtävät:</strong> Ompelija, puvustajan avustaja, valo- ja ääniteknikko</div>
              <div><strong>Sopimus:</strong> Virallinen TE-palveluiden sopimus (työkokeilu / harjoittelu)</div>
              <div><strong>Toimisto:</strong> Sibeliuksenkatu 19B, Helsinki</div>
            </div>
          </div>

          <div class="flex flex-wrap gap-3">
            <a
              href="mailto:info@logrus.fi?subject=CV TE-palveluiden harjoitteluun"
              class="inline-flex items-center gap-2 bg-zinc-950 text-white text-xs font-bold uppercase tracking-wider px-5 py-3 rounded hover:bg-zinc-800 transition-colors"
            >
              Lähetä hakemus &rarr;
            </a>
            <a
              href="/fi/archive"
              class="inline-flex items-center gap-2 bg-transparent border border-zinc-300 text-zinc-800 text-xs font-bold uppercase tracking-wider px-5 py-3 rounded hover:bg-zinc-100 transition-colors"
            >
              Tapahtuma-arkisto
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
