---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Tapahtuma-arkisto ja kronikka — LOGRUS RY"
  description="Logrus ry:n teatteriesitysten, festivaalien, muotinäytösten, työpajojen ja nuorisoprojektien arkisto vuodesta 2010."
  lang="fi"
  ogImage="/images/niskavuori.webp"
>
  <!-- Page Hero -->
  <section class="bg-white border-b border-zinc-200 py-12 sm:py-16 text-center">
    <div class="site-container">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight uppercase mb-3 text-zinc-950">
        Tapahtuma-arkisto
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 max-w-2xl mx-auto font-medium leading-relaxed">
        Teatteriesitysten, festivaalien, muotinäytösten, työpajojen ja nuorisoprojektien historia vuodesta 2010.
      </p>
    </div>
  </section>

  <!-- Controls: Search & Category Filter -->
  <section class="py-8 bg-[#fcfbfa] border-b border-zinc-200/80 sticky top-[73px] z-30 backdrop-blur-md bg-[#fcfbfa]/95">
    <div class="site-container flex flex-col md:flex-row items-center justify-between gap-4">
      
      <!-- Search Input -->
      <div class="w-full md:w-80 relative">
        <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-zinc-400 pointer-events-none fill-none stroke-current stroke-2" width="16" height="16" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <input
          type="text"
          id="archiveSearch"
          placeholder="Hae nimellä tai kuvauksella..."
          aria-label="Hae nimellä tai kuvauksella..."
          class="w-full pl-10 pr-4 py-2.5 bg-white border border-zinc-200 rounded-lg text-xs font-semibold text-zinc-950 placeholder-zinc-400 focus:outline-none focus:border-zinc-950 focus:ring-1 focus:ring-zinc-950 transition-all shadow-xs"
        />
      </div>

      <!-- Category Filter Buttons -->
      <div class="flex flex-wrap items-center gap-2" id="categoryFilters">
        <button class="filter-btn active bg-zinc-950 text-white text-xs font-black uppercase tracking-wider px-4 py-2 rounded-full transition-all cursor-pointer shadow-xs" data-filter="all">Kaikki merkinnät</button>
        <button class="filter-btn bg-zinc-100 text-zinc-700 hover:bg-zinc-200 hover:text-zinc-950 text-xs font-black uppercase tracking-wider px-4 py-2 rounded-full transition-all cursor-pointer" data-filter="Teatteri">Teatteri</button>
        <button class="filter-btn bg-zinc-100 text-zinc-700 hover:bg-zinc-200 hover:text-zinc-950 text-xs font-black uppercase tracking-wider px-4 py-2 rounded-full transition-all cursor-pointer" data-filter="Muoti">Muoti</button>
        <button class="filter-btn bg-zinc-100 text-zinc-700 hover:bg-zinc-200 hover:text-zinc-950 text-xs font-black uppercase tracking-wider px-4 py-2 rounded-full transition-all cursor-pointer" data-filter="Festivals">Festivals</button>
        <button class="filter-btn bg-zinc-100 text-zinc-700 hover:bg-zinc-200 hover:text-zinc-950 text-xs font-black uppercase tracking-wider px-4 py-2 rounded-full transition-all cursor-pointer" data-filter="Tapahtumat">Tapahtumat</button>
        <button class="filter-btn bg-zinc-100 text-zinc-700 hover:bg-zinc-200 hover:text-zinc-950 text-xs font-black uppercase tracking-wider px-4 py-2 rounded-full transition-all cursor-pointer" data-filter="Koulutus">Koulutus</button>
        <button class="filter-btn bg-zinc-100 text-zinc-700 hover:bg-zinc-200 hover:text-zinc-950 text-xs font-black uppercase tracking-wider px-4 py-2 rounded-full transition-all cursor-pointer" data-filter="Studiot">Studiot</button>

      </div>

    </div>
  </section>

  <!-- Archive Content Stream -->
  <section class="py-12 sm:py-16 flex-1">
    <div class="site-container" id="archiveList">
      
      <!-- Year 2025 -->
      <section class="year-group mb-14 sm:mb-16" data-year="2025">
        <div class="flex items-center gap-4 mb-6 sm:mb-8">
          <span class="bg-zinc-950 text-white text-xs sm:text-sm font-black tracking-widest uppercase px-4 py-1.5 rounded-full">
            2025
          </span>
          <div class="flex-1 h-px bg-zinc-200"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
          
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Teatteri">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Teatteri
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  03.02.2025
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                🎭 Avoin teatteriryhmä Logrus-teatterissa
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Logrus-teatterin luova tiimi avaa ovensa teatteritaiteen kiehtovaan maailmaan! Ainutlaatuinen tilaisuus sukeltaa näyttämön taikaan, vapauttaa luova potentiaalisi ja oppia näyttelijäntyön perusteet.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Ryhmähaku</span></div>
          </article>
        </div>
      </section>
      <!-- Year 2024 -->
      <section class="year-group mb-14 sm:mb-16" data-year="2024">
        <div class="flex items-center gap-4 mb-6 sm:mb-8">
          <span class="bg-zinc-950 text-white text-xs sm:text-sm font-black tracking-widest uppercase px-4 py-1.5 rounded-full">
            2024
          </span>
          <div class="flex-1 h-px bg-zinc-200"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
          
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Tapahtumat">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Tapahtumat
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  07.12.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Videokooste: "Joulutapaamiset" Helsingissä
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Logrus ry:n ja Encanta Oy:n yhteistapahtuma. Upea konsertti ja juhla: Sergei Florov ("shamaani tamburiinilla") avasi illan luoden tilaan lämpimän tunnelman ja uudenvuoden taikaa.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Juhla</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Teatteri">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Teatteri
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  15.09.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Koko perheen näytelmä: "Kadonnut sormus"
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Helmi-keskuksen nuorisoteatteri ja Logrus Ry esittivät vauhdikkaan koko perheen näytelmän klassisten englantilaisten satujen pohjalta. Kiitämme osallistujia ja katsojia lämpimästä tuesta ja satumaisesta tunnelmasta!
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Ensi-ilta</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Festivals">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Festivals
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  03.08.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Kouvolan keskiaikamarkkinat
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Logrus Ry osallistui Kouvolan perinteisille keskiaikamarkkinoille. Esittelyssä oli aidoista luonnonpellavasta ja puuvillasta käsin valmistettuja historiallisia mekkoja ja paitoja.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Markkinat</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Tapahtumat">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Tapahtumat
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  10.05.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Kävelykierros Helsingissä Alexandre Vassilievin kanssa
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Keväinen kävelyretki ja vapaamuotoinen tapaaminen Helsingissä maailmankuulun muotihistorioitsijan ja taiteentutkijan Alexandre Vassilievin kanssa yhteistyössä Logrus ry:n ja Encanta Oy:n kanssa.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Tapaaminen</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Teatteri">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Teatteri
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  07.04.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Näytelmä "Kaunis elämä" kiertueella Jyväskylässä
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Logrus-teatterin kiertue-esitys Jyväskylässä Jean Anouilhin vallankumouksellisella tragikomedialla "Kaunis elämä" (ohjaus Akvilė Ruzgaitė). Lämpimät kiitokset yleisölle ja kumppaneille!
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Kiertue</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Muoti">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Muoti
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  09.02.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Vanhojen tanssien pukuvuokraus
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Perinteiset lukion Vanhojen tanssit Helsingissä! Logrus ry ja Encanta Oy tarjoavat laajan valikoiman tanssiaismekkoja, frakkeja ja asusteita edulliseen hintaan yksilöllisellä sovituksella.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Puvut</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Studiot">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Studiot
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  03.02.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Avoin flamencotanssin työpaja
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Maksuton alkeistunti "Flamencoa aloittelijoille" opettaja Raisat Gesselin johdolla nuorisokeskus Luupissa (Kontula, Helsinki). Tutustuminen perusrytmeihin, ryhtiin ja tanssin ilmaisuun.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Työpaja</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Koulutus">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Koulutus
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  20.01.2024
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Alla Novozheninan luentosarja: "Paholainen pukeutuu Pradaan"
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Ohjaajan ja puhekouluttajan Alla Novozheninan luento Narri-salissa (Sörnäisten rantatie 31 A). Kiehtova katsaus muotimaailman lainalaisuuksiin, tyylidramaturgiaan ja ruutuhahmojen psykologiaan.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Luento</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Työharjoittelu">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Työharjoittelu
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  Harjoitteluohjelma
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Työharjoittelu ja vapaaehtoistyö TE-toimiston kautta
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Logrus ry tarjoaa harjoittelupaikkoja: apulaisohjaaja, puvustaja/ompelija, valo- ja ääniteknikko, stailistin avustaja sekä kulttuuriprojektien koordinaattori.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Työharjoittelu</span></div>
          </article>
        </div>
      </section>
      <!-- Year 2023 -->
      <section class="year-group mb-14 sm:mb-16" data-year="2023">
        <div class="flex items-center gap-4 mb-6 sm:mb-8">
          <span class="bg-zinc-950 text-white text-xs sm:text-sm font-black tracking-widest uppercase px-4 py-1.5 rounded-full">
            2023
          </span>
          <div class="flex-1 h-px bg-zinc-200"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
          
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Teatteri">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Teatteri
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  Ohjelmistokausi
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Näytelmä "Novecento" (Alessandro Baricco)
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Alessandro Bariccon legendaariseen teokseen "1900" perustuva esitys. Logrus-teatterin ja DanceSport-studion yhteistuotanto Narrin näyttämöllä (Sörnäisten rantatie 31).
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Draama / Tango</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Koulutus">
            <div class="flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="bg-zinc-100 text-zinc-800 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded">
                  Koulutus
                </span>
                <span class="text-xs font-semibold text-zinc-500">
                  24.09.2023
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black uppercase text-zinc-950 leading-snug mb-2.5 group-hover:text-zinc-700 transition-colors">
                Työpaja: "Esiintymistaito aikuisille"
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium mb-4 flex-1">
                Käytännön puhetekniikkavalmennus, esiintymisjännityksen purkaminen ja itsevarma esiintyminen Alla Novozheninan johdolla kulttuuriaktiiveille ja teatteriharrastajille.
              </p>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2 mt-auto"><span class="text-[11px] font-bold text-zinc-600 bg-zinc-50 border border-zinc-200/80 px-2.5 py-1 rounded">Työpaja</span></div>
          </article>
          <article class="archive-card bg-white border border-zinc-200 rounded-lg p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-200 group border-t-4 border-t-zinc-950" data-category="Valokuva ja taide">
