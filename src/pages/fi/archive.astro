---
import BaseLayout from "@/layouts/BaseLayout.astro";

const archiveItemsFestivals = [
  {
    tag: 'Festivaali / Leiri',
    title: '«Yhteisöllinen ympäristö» ja kotouttaminen',
    date: '2022 — 2024',
    image: '/images/card-involved.webp',
    description: 'Kulttuuritapaamisten sarja, kielityöpajat ja nuorten kotouttamisleirit Suomessa.',
    meta: [
      { label: 'Yhteistyössä', val: 'Caisa, Kanneltalo, TE-toimisto' },
    ],
  },
  {
    tag: 'Työpajat ja studiot',
    title: 'Kävely- ja tanssistudiot',
    date: 'Kausi 2025 — 2026',
    image: '/images/card-initiatives.webp',
    description: 'Maksutonta luovaa toimintaa 14–25-vuotiaille nuorille. Esiintymistaitojen harjoittelua perinteisissä puvuissa ja gaala.',
    meta: [
      { label: 'Paikka', val: 'Nuorisotalo Kontula, Ostostie 4, Helsinki' },
      { label: 'Tila', val: 'Hanke on onnistuneesti toteutettu' },
    ],
  },
];

const archiveItemsPast = [
  {
    tag: 'Näytelmä',
    title: '«NOVECENTO»',
    date: 'Marraskuu 2025',
    image: '/images/theatre-art.webp',
    description: 'Alessandro Bariccon näytelmään perustuva esitys yhteistyössä DanceSport Studio -seuran kanssa. Tarina valtamerialuksen pianistista.',
    meta: [
      { label: 'Ohjaaja', val: 'Akvile Ruzgyte' },
      { label: 'Näyttämö', val: 'Narri, Sörnäisten rantatie 31, Helsinki' },
    ],
  },
  {
    tag: 'Näytelmä',
    title: '«SILVIA»',
    date: '2026',
    image: '/images/card-archive.webp',
    description: 'A. R. Gurneyn näytelmään pohjautuva komediallinen ja lämminhenkinen esitys ystävyydestä ja perheestä.',
    meta: [
      { label: 'Teatteri', val: 'Logrus Teatteri' },
      { label: 'Näyttämö', val: 'Narrin näyttämö' },
    ],
  },
  {
    tag: 'Perhenäytelmä',
    title: '«Kadonneen sormuksen arvoitus»',
    date: 'Kausi 2024',
    image: '/images/card-about.webp',
    description: 'Helmi-keskuksen nuorisoteatterin interaktiivinen perhenäytelmä klassisten satujen innoittamana.',
    meta: [
      { label: 'Järjestäjä', val: 'Logrus ry / Helmi-keskus' },
    ],
  },
  {
    tag: 'Draama',
    title: '«Niskavuoren nuori emäntä»',
    date: '2021 — 2022',
    image: '/images/niskavuori.webp',
    description: 'Hella Wuolijoen klassikkodraama perinteiden, vallan ja rakkauden ristiriidoista Niskavuoren tilalla.',
    meta: [
      { label: 'Teatteri', val: 'Logrus Teatteri' },
    ],
  },
  {
    tag: 'Muotinäytös',
    title: 'Muotinäytös «The Hipsters»',
    date: '2019',
    image: '/images/fashion-hipsters.webp',
    description: 'Nuorten retro- ja vintage-asujen muotinäytös, puvut valmistettu Logrus ry:n pukutyöpajassa.',
    meta: [
      { label: 'Järjestäjä', val: 'Logrus ry' },
    ],
  },
  {
    tag: 'Festivaali',
    title: 'Kansainvälinen festivaali «Art-Planet»',
    date: '2016 — 2018',
    image: '/images/art-planet-2020.webp',
    description: 'Monitaiteinen lasten ja nuorten festivaali, johon osallistui taiteilijoita Itämeren alueelta.',
    meta: [
      { label: 'Paikka', val: 'Helsinki' },
    ],
  },
  {
    tag: 'Kilpailu',
    title: 'Festivaali-kilpailu «Gloria Star»',
    date: '2013 — 2015',
    image: '/images/spektr-2016.webp',
    description: 'Laulu- ja tanssikatselmus nuorille lupauksille kansainvälisen tuomariston johdolla.',
    meta: [
      { label: 'Järjestäjä', val: 'Logrus ry' },
    ],
  },
];
---

<BaseLayout
  title="Tapahtuma- ja esitysarkisto — LOGRUS RY"
  description="LOGRUS ry:n teatteriesitysten, festivaalien ja nuorisohankkeiden arkisto vuodesta 2012 alkaen."
  lang="fi"
  ogImage="/images/card-archive.webp"
>
  <!-- Page Hero -->
  <section class="bg-white border-b border-zinc-200 py-12 sm:py-16 text-center">
    <div class="site-container">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight uppercase mb-3">
        Tapahtuma-arkisto
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 max-w-xl mx-auto font-medium">
        Esitysten, festivaalien, muotiprojektien ja nuorisoaloitteiden kronikka vuodesta 2012 alkaen.
      </p>
    </div>
  </section>

  <!-- Archive Timeline Section -->
  <section class="py-14 sm:py-16">
    <div class="site-container">
      
      <!-- Section: Festivals & Studios -->
      <div class="mb-16">
        <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-zinc-950 mb-8 border-b-2 border-zinc-950 pb-2 inline-block">
          Festivaalit ja studiot
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
          {archiveItemsFestivals.map((item, index) => (
            <div class="bg-white border border-zinc-200 rounded-lg overflow-hidden flex flex-col shadow-sm transition-transform duration-200 hover:-translate-y-1">
              <div class="h-56 relative bg-zinc-900 overflow-hidden">
                <span class="absolute top-3 left-3 bg-zinc-950/80 backdrop-blur-xs text-white text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded z-10">
                  {item.tag}
                </span>
                <img
                  src={item.image}
                  alt={item.title}
                  width="480"
                  height="320"
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                  fetchpriority={index === 0 ? "high" : undefined}
                  class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                />
              </div>
              <div class="p-6 flex flex-col flex-1 justify-between">
                <div>
                  <div class="text-xs font-bold text-zinc-600 mb-1.5">{item.date}</div>
                  <h3 class="text-lg font-black uppercase text-zinc-950 mb-2.5 leading-snug">{item.title}</h3>
                  <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed mb-4">{item.description}</p>
                </div>
                <div class="pt-3 border-t border-zinc-100 text-xs text-zinc-600 space-y-1">
                  {item.meta.map((m) => (
                    <div><strong>{m.label}:</strong> {m.val}</div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Section: Past Seasons -->
      <div>
        <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-zinc-950 mb-8 border-b-2 border-zinc-950 pb-2 inline-block">
          Aiemmin ohjelmistossa
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
          {archiveItemsPast.map((item) => (
            <div class="bg-white border border-zinc-200 rounded-lg overflow-hidden flex flex-col shadow-sm transition-transform duration-200 hover:-translate-y-1">
              <div class="h-56 relative bg-zinc-900 overflow-hidden">
                <span class="absolute top-3 left-3 bg-zinc-950/80 backdrop-blur-xs text-white text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded z-10">
                  {item.tag}
                </span>
                <img
                  src={item.image}
                  alt={item.title}
                  width="480"
                  height="320"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                />
              </div>
              <div class="p-6 flex flex-col flex-1 justify-between">
                <div>
                  <div class="text-xs font-bold text-zinc-600 mb-1.5">{item.date}</div>
                  <h3 class="text-lg font-black uppercase text-zinc-950 mb-2.5 leading-snug">{item.title}</h3>
                  <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed mb-4">{item.description}</p>
                </div>
                <div class="pt-3 border-t border-zinc-100 text-xs text-zinc-600 space-y-1">
                  {item.meta.map((m) => (
                    <div><strong>{m.label}:</strong> {m.val}</div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</BaseLayout>