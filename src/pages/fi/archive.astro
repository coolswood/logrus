---
import BaseLayout from '@/layouts/BaseLayout.astro';

const archiveItems2025_2026 = [
  {
    tag: 'Teatteriesitys',
    title: '«NOVECENTO»',
    date: 'Marraskuu 2025',
    image: '/images/card-theatre.webp',
    description: 'Alessandro Bariccon pienoisromaaniin perustuva näytelmä yhteistyössä DanceSport Studion kanssa. Tarina valtamerilaivalla syntyneestä pianistista.',
    meta: [
      { label: 'Ohjaaja', val: 'Akvile Ruzgyte' },
      { label: 'Näyttämö', val: 'Narrin näyttämö, Sörnäisten rantatie 31, Helsinki' },
    ],
  },
  {
    tag: 'Nuorisotyöpajat',
    title: 'Catwalk- ja tanssistudiot',
    date: 'Kausi 2025 — 2026',
    image: '/images/card-initiatives.webp',
    description: 'Maksuttomat luovat tunnit 14–25-vuotiaille. Esiintymistaito, perinteiset puvut ja valmistautuminen gaalaesitykseen.',
    meta: [
      { label: 'Paikka', val: 'Kontulan nuorisotalo, Ostostie 4, Helsinki' },
      { label: 'Tila', val: 'Projekti toteutettu menestyksekkäästi' },
    ],
  },
  {
    tag: 'Teatteriesitys',
    title: '«SILVIA»',
    date: '2026',
    image: '/images/card-archive.webp',
    description: 'A. R. Gurneyn lämminhenkinen ja nokkela Broadway-komedia ystävyydestä ja perhe-elämän käänteistä.',
    meta: [
      { label: 'Teatteri', val: 'Logrus Teatteri' },
      { label: 'Näyttämö', val: 'Narrin näyttämö' },
    ],
  },
];

const archiveItemsPast = [
  {
    tag: 'Perhenäytelmä',
    title: '«Kadonneen sormuksen salaisuus»',
    date: 'Kausi 2024',
    image: '/images/card-about.webp',
    description: 'Helmi-keskuksen nuorisoteatterin interaktiivinen perhe-esitys klassisten englantilaisten satujen pohjalta.',
    meta: [
      { label: 'Järjestäjä', val: 'Logrus Ry / Helmi-keskus' },
    ],
  },
  {
    tag: 'Festivaali / Leiri',
    title: 'Yhteiskunnallinen ilmapiiri & kotoutuminen',
    date: '2022 — 2024',
    image: '/images/card-involved.webp',
    description: 'Kulttuurikohtaamisia, kielen oppimisen työpajoja ja nuorten integraatioleirejä Suomessa.',
    meta: [
      { label: 'Yhteistyökumppanit', val: 'Caisa, Kanneltalo, TE-toimisto' },
    ],
  },
  {
    tag: 'Draama',
    title: '«Niskavuoren nuori emäntä»',
    date: '2021 — 2022',
    image: '/images/niskavuori.webp',
    description: 'Hella Wuolijoen klassikkodraama velvollisuudesta, perinteistä ja rakkaudesta Niskavuoren tilalla.',
    meta: [
      { label: 'Teatteri', val: 'Logrus Teatteri' },
    ],
  },
  {
    tag: 'Muotinäytös',
    title: '«The Hipsters» -catwalk',
    date: '2019',
    image: '/images/fashion-hipsters.webp',
    description: 'Nuorten vintage- ja tyylipukujen muotinäytös, jotka valmistettiin Logrus ry:n puvustamossa.',
    meta: [
      { label: 'Järjestäjä', val: 'Logrus ry' },
    ],
  },
  {
    tag: 'Festivaali',
    title: 'Kansainvälinen festivaali «Art-Planet»',
    date: '2016 — 2018',
    image: '/images/art-planet-2020.webp',
    description: 'Vuotuinen monitaiteinen nuorisofestivaali, joka kokosi esiintyjäryhmiä eri Itämeren maista.',
    meta: [
      { label: 'Paikka', val: 'Helsinki' },
    ],
  },
  {
    tag: 'Kilpailu',
    title: '«Gloria Star» -lahjakkuuskilpailu',
    date: '2013 — 2015',
    image: '/images/spektr-2016.webp',
    description: 'Laulu- ja tanssikilpailu nuorille lahjakkuuksille kansainvälisellä tuomaristolla.',
    meta: [
      { label: 'Järjestäjä', val: 'Logrus ry' },
    ],
  },
];
---

<BaseLayout
  title="Tapahtuma-arkisto — LOGRUS RY"
  description="LOGRUS ry:n teatteriesitysten, Gloria Star- ja Art-Planet -festivaalien arkisto vuodesta 2012."
  lang="fi"
  ogImage="/images/card-archive.webp"
>
  <!-- Page Hero -->
  <section class="bg-white border-b border-zinc-200 py-12 sm:py-16 text-center">
    <div class="site-container">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight uppercase mb-3">
        Tapahtuma-arkisto
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 max-w-xl mx-auto font-medium">
        Teatteriesitysten, kansainvälisten festivaalien ja nuorisoaloitteiden kronikka vuodesta 2012.
      </p>
    </div>
  </section>

  <!-- Archive Timeline Section -->
  <section class="py-14 sm:py-16">
    <div class="site-container">
      
      <!-- Section: 2025 - 2026 -->
      <div class="mb-16">
        <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-zinc-950 mb-8 border-b-2 border-zinc-950 pb-2 inline-block">
          2025 — 2026
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
          {archiveItems2025_2026.map((item) => (
            <div class="bg-white border border-zinc-200 rounded-lg overflow-hidden flex flex-col shadow-sm transition-transform duration-200 hover:-translate-y-1">
              <div class="h-56 relative bg-zinc-900 overflow-hidden">
                <span class="absolute top-3 left-3 bg-zinc-950/80 backdrop-blur-xs text-white text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded z-10">
                  {item.tag}
                </span>
                <img
                  src={item.image}
                  alt={item.title}
                  width="480"
                  height="320"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                />
              </div>
              <div class="p-6 flex flex-col flex-1 justify-between">
                <div>
                  <div class="text-xs font-bold text-zinc-400 mb-1.5">{item.date}</div>
                  <h3 class="text-lg font-black uppercase text-zinc-950 mb-2.5 leading-snug">{item.title}</h3>
                  <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed mb-4">{item.description}</p>
                </div>
                <div class="pt-3 border-t border-zinc-100 text-xs text-zinc-600 space-y-1">
                  {item.meta.map((m) => (
                    <div><strong>{m.label}:</strong> {m.val}</div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Section: Past Seasons -->
      <div>
        <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-zinc-950 mb-8 border-b-2 border-zinc-950 pb-2 inline-block">
          Aiemmat esitykset ja projektit
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
          {archiveItemsPast.map((item) => (
            <div class="bg-white border border-zinc-200 rounded-lg overflow-hidden flex flex-col shadow-sm transition-transform duration-200 hover:-translate-y-1">
              <div class="h-56 relative bg-zinc-900 overflow-hidden">
                <span class="absolute top-3 left-3 bg-zinc-950/80 backdrop-blur-xs text-white text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded z-10">
                  {item.tag}
                </span>
                <img
                  src={item.image}
                  alt={item.title}
                  width="480"
                  height="320"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                />
              </div>
              <div class="p-6 flex flex-col flex-1 justify-between">
                <div>
                  <div class="text-xs font-bold text-zinc-400 mb-1.5">{item.date}</div>
                  <h3 class="text-lg font-black uppercase text-zinc-950 mb-2.5 leading-snug">{item.title}</h3>
                  <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed mb-4">{item.description}</p>
                </div>
                <div class="pt-3 border-t border-zinc-100 text-xs text-zinc-600 space-y-1">
                  {item.meta.map((m) => (
                    <div><strong>{m.label}:</strong> {m.val}</div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
