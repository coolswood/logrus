---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeaturedCard from '@/components/FeaturedCard.astro';
---

<BaseLayout
  title="LOGRUS RY — Kansainvälinen nuorisoseura"
  description="LOGRUS ry:n virallinen verkkosivusto: teatteri, nuorten luovat työpajat, tanssitunnit ja harjoittelupaikat Helsingissä."
  lang="fi"
>
  <!-- Hero Section -->
  <section class="text-center pt-10 pb-12 sm:pt-14 sm:pb-16">
    <div class="site-container">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight uppercase mb-2 leading-none">
        LOGRUS RY
      </h1>
      <div class="text-lg sm:text-2xl font-extrabold tracking-[0.15em] uppercase text-zinc-800 mb-5">
        THEATRE & CULTURE ASSOCIATION
      </div>
      <div class="w-28 h-0.5 bg-zinc-950 mx-auto mb-5"></div>
      <p class="text-xs sm:text-sm font-semibold tracking-widest uppercase text-zinc-600 max-w-xl mx-auto">
        Kansainvälinen nuorisoaloitteiden tukiyhdistys
      </p>
    </div>
  </section>

  <!-- 2x2 Cards Grid -->
  <section class="pb-20">
    <div class="site-container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-7 sm:gap-8">
        <!-- TEATTERI -->
        <FeaturedCard
          title="TEATTERI"
          description="Logrus-teatterin viralliset sivut: ohjelmisto, esitykset, näyttelijät ja ensi-illat"
          image="/images/card-theatre.webp"
          href="https://www.teatterilogrus.fi/"
          external={true}
          icon="theatre"
          variant="dark"
          priority={true}
        />

        <!-- PROJEKTIT -->
        <FeaturedCard
          title="PROJEKTIT"
          description="Työpajat, nuorisoaloitteet, rekvisiitan vuokraus ja paljon muuta"
          image="/images/card-initiatives.webp"
          href="/fi/projects"
          icon="projects"
          variant="light"
          priority={true}
        />

        <!-- ARKISTO -->
        <FeaturedCard
          title="ARKISTO"
          description="Esitysten historia, menneet tapahtumat, festivaalit ja kuvagalleria"
          image="/images/card-archive.webp"
          href="/fi/archive"
          icon="archive"
          variant="light"
        />

        <!-- MEISTÄ -->
        <FeaturedCard
          title="MEISTÄ"
          description="Missiomme, arvomme, tiimin yhteystiedot ja TE-toimiston harjoittelupaikat"
          image="/images/card-about.webp"
          href="/fi/about"
          icon="about"
          variant="light"
        />
      </div>
    </div>
  </section>
</BaseLayout>
