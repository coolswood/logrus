---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Meistä — Logrus ry"
  description="Logrus ry (Y-tunnus 2040144-2) on vuonna 2006 perustettu yleishyödyllinen kulttuuriyhdistys: esittävä taide, teatteripedagogiikka ja kulttuurienvälinen vuoropuhelu Helsingissä."
  lang="fi"
>
  <!-- Sivuotsikko / Hero -->
  <section class="border-b border-zinc-200 bg-white py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase tracking-tight text-zinc-950 mb-3">
        Meistä
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 max-w-2xl">
        Kulttuuriyhdistys Logrus ry (Helsinki)
      </p>
    </div>
  </section>

  <!-- Pääsisältö -->
  <section class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="bg-white border border-zinc-200 rounded-lg p-6 sm:p-10 md:p-12 shadow-sm space-y-10">

        <!-- Johdanto -->
        <p class="text-base sm:text-lg text-zinc-800 leading-relaxed font-normal">
          <strong class="font-bold text-zinc-950">Logrus ry</strong> on vuonna 2006 Helsingissä perustettu rekisteröity yleishyödyllinen kulttuuriyhdistys (Y-tunnus 2040144-2). Yhdistys on toiminut pääkaupunkiseudulla yli 20 vuotta esittävän taiteen, teatteripedagogiikan ja kulttuurienvälisen vuoropuhelun kentällä.
        </p>

        <!-- Avainluvut -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 p-6 bg-[#faf9f7] border border-zinc-200 rounded-lg">
          <div>
            <div class="text-2xl sm:text-3xl font-black text-zinc-950">20 vuotta</div>
            <div class="text-xs sm:text-sm text-zinc-600 mt-1">jatkuvaa kulttuuritoimintaa pääkaupunkiseudulla (vuodesta 2006)</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-black text-zinc-950">25+</div>
            <div class="text-xs sm:text-sm text-zinc-600 mt-1">itsenäistä produktiota ja hanketta</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-black text-zinc-950">15 000+</div>
            <div class="text-xs sm:text-sm text-zinc-600 mt-1">katsojaa ja eri sukupolvien osallistujaa</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-black text-zinc-950">100%</div>
            <div class="text-xs sm:text-sm text-zinc-600 mt-1">hallinnon läpinäkyvyys ja tarkka raportointi</div>
          </div>
        </div>

        <!-- Toiminta-ajatus ja strategiset painopisteet -->
        <div class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-black uppercase tracking-tight text-zinc-950 pb-3 border-b border-zinc-200">
            Toiminta-ajatus ja strategiset painopisteet
          </h2>
          <p class="text-sm sm:text-base text-zinc-700 leading-relaxed">
            Logrus ry:n tavoitteena on olla avoin, osallistava ja turvallinen kulttuuriyhteisö, jossa esittävä taide toimii kotoutumisen, hyvinvoinnin, sukupolvien välisen dialogin ja yhteisöllisyyden rakentajana.
          </p>
          <ul class="space-y-3 text-sm sm:text-base text-zinc-700">
            <li class="flex items-start gap-2.5">
              <span class="text-zinc-950 font-bold select-none">—</span>
              <span><strong class="font-bold text-zinc-950">Taiteellinen laatu ja jatkuvuus:</strong> Uusien näyttämöteosten tuottaminen ja esittäminen yhteistyössä pääkaupunkiseudun kulttuurikeskusten sekä ammattitaiteilijoiden kanssa.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-zinc-950 font-bold select-none">—</span>
              <span><strong class="font-bold text-zinc-950">Matalan kynnyksen saavutettavuus:</strong> Taidekasvatuksen, kielituen ja työpajojen tarjoaminen esteettömästi ja taloudellisesti saavutettavasti eri-ikäisille.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-zinc-950 font-bold select-none">—</span>
              <span><strong class="font-bold text-zinc-950">Kotoutuminen taiteen keinoin:</strong> Moninaisuuden, sosiaalisen osallisuuden ja eri kieliryhmien välisen vuorovaikutuksen vahvistaminen yhteisen luovan toiminnan kautta.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-zinc-950 font-bold select-none">—</span>
              <span><strong class="font-bold text-zinc-950">Turvallisemman tilan periaatteet:</strong> Yhdistyksen hyväksymän Yhdenvertaisuus- ja saavutettavuussuunnitelman (2026–2028) aktiivinen noudattaminen, syrjimättömyys ja nimetyn häirintäyhdyshenkilön tuki.</span>
            </li>
          </ul>
        </div>

        <!-- Toimintamuodot -->
        <div class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-black uppercase tracking-tight text-zinc-950 pb-3 border-b border-zinc-200">
            Toimintamuodot
          </h2>
          <ul class="space-y-3 text-sm sm:text-base text-zinc-700">
            <li class="flex items-start gap-2.5">
              <span class="text-zinc-950 font-bold select-none">—</span>
              <span><strong class="font-bold text-zinc-950">Esittävä taide ja teatterituotanto:</strong> Monikieliset, visuaaliset ja fyysisen teatterin näyttämöteokset, jotka tekstitetään suomeksi tai hyödyntävät universaalia kehollista ilmaisua. Virallinen teatterisivusto: <a href="https://www.teatterilogrus.fi/" target="_blank" rel="noopener noreferrer" class="underline hover:text-zinc-950">teatterilogrus.fi</a>.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-zinc-950 font-bold select-none">—</span>
              <span><strong class="font-bold text-zinc-950">Taidekasvatus ja säännöllinen kerhotoiminta:</strong> Teatteri- ja ilmaisutaidon kurssit, ekomuotikoulu, tanssi- ja liikeilmaisupajat sekä suomen kielen ja kulttuurin toiminnalliset tukipisteet lapsille, nuorille ja aikuisille.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-zinc-950 font-bold select-none">—</span>
              <span><strong class="font-bold text-zinc-950">Yhteistyö- ja kumppanuushankkeet:</strong> Yhteistuotannot pääkaupunkiseudun kulttuurikeskusten (kuten Caisa, Kanneltalo) kanssa ja osallistuminen taidefestivaaleihin Suomessa.</span>
            </li>
          </ul>
        </div>

        <!-- Hallitus ja toimihenkilöt -->
        <div class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-black uppercase tracking-tight text-zinc-950 pb-3 border-b border-zinc-200">
            Hallitus ja toimihenkilöt (toimikausi 2026–2027)
          </h2>
          <p class="text-sm sm:text-base text-zinc-700 leading-relaxed">
            LOGRUS ry:n sääntömääräisessä kokouksessa on valittu yhdistyksen hallitus sekä toimihenkilöt toimikaudelle 2026–2027 seuraavassa kokoonpanossa:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="p-5 bg-[#faf9f7] border border-zinc-200 rounded-md">
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="font-bold text-zinc-950 text-base">Akvile Ruzgyte</span>
                <span class="text-[11px] font-bold bg-zinc-900 text-white px-2.5 py-0.5 rounded">Puheenjohtaja</span>
              </div>
              <p class="text-xs sm:text-sm text-zinc-600 leading-normal">Hallituksen johtaminen ja yhdistyksen edustaminen</p>
            </div>

            <div class="p-5 bg-[#faf9f7] border border-zinc-200 rounded-md">
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="font-bold text-zinc-950 text-base">Olga Hiltunen</span>
                <span class="text-[11px] font-bold bg-zinc-900 text-white px-2.5 py-0.5 rounded">Sihteeri</span>
              </div>
              <p class="text-xs sm:text-sm text-zinc-600 leading-normal">Hallituksen jäsen, pöytäkirjat ja yhdistyksen asiakirjat</p>
            </div>

            <div class="p-5 bg-[#faf9f7] border border-zinc-200 rounded-md">
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="font-bold text-zinc-950 text-base">Evgenii Lapin</span>
                <span class="text-[11px] font-bold bg-zinc-900 text-white px-2.5 py-0.5 rounded">Hallituksen jäsen</span>
              </div>
              <p class="text-xs sm:text-sm text-zinc-600 leading-normal">Hallitustyöskentely ja yhdistystoiminnan kehittäminen</p>
            </div>

            <div class="p-5 bg-[#faf9f7] border border-zinc-200 rounded-md">
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="font-bold text-zinc-950 text-base">Olga Lapina</span>
                <span class="text-[11px] font-bold bg-red-600 text-white px-2.5 py-0.5 rounded">Toiminnanjohtaja</span>
              </div>
              <p class="text-xs sm:text-sm text-zinc-600 leading-normal">Operatiivisen toiminnan, teatterin ja kurssien johtaminen</p>
            </div>
          </div>
        </div>

        <!-- Hallinto ja avoimuus -->
        <div class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-black uppercase tracking-tight text-zinc-950 pb-3 border-b border-zinc-200">
            Hallinto ja avoimuus
          </h2>
          <p class="text-sm sm:text-base text-zinc-700 leading-relaxed">
            Yhdistyksen toiminta noudattaa tarkasti Suomen yhdistyslakia ja EU:n tietosuoja-asetusta (GDPR). Keskeiset viralliset asiakirjat ovat avoimesti saatavilla yhteistyökumppaneille ja rahoittajille:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 pt-2">
            <a
              href="/docs/saannot.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-4 bg-[#faf9f7] border border-zinc-200 rounded-md hover:bg-[#f3f1ee] hover:border-zinc-400 transition-all group"
            >
              <div class="flex items-center gap-3">
                <svg class="h-5 w-5 text-red-600 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zM6 20V4h7v5h5v11H6z"/>
                </svg>
                <span class="text-xs sm:text-sm font-semibold text-zinc-900 group-hover:text-zinc-950">Yhdistyksen säännöt</span>
              </div>
              <span class="text-[10px] font-bold bg-zinc-200 text-zinc-800 px-2 py-0.5 rounded">PDF</span>
            </a>

            <a
              href="/docs/hallitus_2026_2027_logrus_ry.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-4 bg-[#faf9f7] border border-zinc-200 rounded-md hover:bg-[#f3f1ee] hover:border-zinc-400 transition-all group"
            >
              <div class="flex items-center gap-3">
                <svg class="h-5 w-5 text-red-600 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zM6 20V4h7v5h5v11H6z"/>
                </svg>
                <span class="text-xs sm:text-sm font-semibold text-zinc-900 group-hover:text-zinc-950">Hallitus ja toimihenkilöt 2026–2027</span>
              </div>
              <span class="text-[10px] font-bold bg-zinc-200 text-zinc-800 px-2 py-0.5 rounded">PDF</span>
            </a>

            <a
              href="/docs/toimintasuunnitelma.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-4 bg-[#faf9f7] border border-zinc-200 rounded-md hover:bg-[#f3f1ee] hover:border-zinc-400 transition-all group"
            >
              <div class="flex items-center gap-3">
                <svg class="h-5 w-5 text-red-600 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zM6 20V4h7v5h5v11H6z"/>
                </svg>
                <span class="text-xs sm:text-sm font-semibold text-zinc-900 group-hover:text-zinc-950">Toimintasuunnitelma 2027</span>
              </div>
              <span class="text-[10px] font-bold bg-zinc-200 text-zinc-800 px-2 py-0.5 rounded">PDF</span>
            </a>

            <a
              href="/docs/yhdenvertaisuus.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-4 bg-[#faf9f7] border border-zinc-200 rounded-md hover:bg-[#f3f1ee] hover:border-zinc-400 transition-all group"
            >
              <div class="flex items-center gap-3">
                <svg class="h-5 w-5 text-red-600 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zM6 20V4h7v5h5v11H6z"/>
                </svg>
                <span class="text-xs sm:text-sm font-semibold text-zinc-900 group-hover:text-zinc-950">Yhdenvertaisuus (2026–2028)</span>
              </div>
              <span class="text-[10px] font-bold bg-zinc-200 text-zinc-800 px-2 py-0.5 rounded">PDF</span>
            </a>

            <a
              href="/docs/tietosuojaseloste_logrus_ry.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-4 bg-[#faf9f7] border border-zinc-200 rounded-md hover:bg-[#f3f1ee] hover:border-zinc-400 transition-all group"
            >
              <div class="flex items-center gap-3">
                <svg class="h-5 w-5 text-red-600 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zM6 20V4h7v5h5v11H6z"/>
                </svg>
                <span class="text-xs sm:text-sm font-semibold text-zinc-900 group-hover:text-zinc-950">Tietosuojaseloste (GDPR)</span>
              </div>
              <span class="text-[10px] font-bold bg-zinc-200 text-zinc-800 px-2 py-0.5 rounded">PDF</span>
            </a>
          </div>
        </div>

        <!-- Official Details -->
        <div class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-black uppercase tracking-tight text-zinc-950 pb-3 border-b border-zinc-200">
            Viralliset rekisteritiedot ja yhteystiedot
          </h2>
          <div class="p-6 bg-[#faf9f7] border border-zinc-200 rounded-lg text-sm sm:text-base text-zinc-700 space-y-2 leading-relaxed">
            <p><strong class="font-bold text-zinc-950">Rekisteröity nimi:</strong> LOGRUS – kansainvälinen nuorisoaloitteiden tukiyhdistys ry</p>
            <p><strong class="font-bold text-zinc-950">Yhdistys:</strong> Logrus ry (Kulttuuriyhdistys Logrus ry)</p>
            <p><strong class="font-bold text-zinc-950">Y-tunnus:</strong> 2040144-2</p>
            <p><strong class="font-bold text-zinc-950">Perustamisvuosi:</strong> 2006</p>
            <p><strong class="font-bold text-zinc-950">Kotipaikka ja osoite:</strong> Sibeliuksenkatu 19B19, 00250 Helsinki</p>
            <p><strong class="font-bold text-zinc-950">Sähköposti:</strong> <a href="mailto:info@logrus.fi" class="underline hover:text-zinc-950">info@logrus.fi</a></p>
            <p><strong class="font-bold text-zinc-950">Verkkosivustot:</strong> <a href="https://logrus.fi" target="_blank" rel="noopener noreferrer" class="underline hover:text-zinc-950">logrus.fi</a> | <a href="https://www.teatterilogrus.fi/" target="_blank" rel="noopener noreferrer" class="underline hover:text-zinc-950">www.teatterilogrus.fi</a></p>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
